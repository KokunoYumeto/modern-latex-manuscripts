{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/modern-latex-manuscripts/raw/main/manifests/stacks-entry.schema.json",
  "title": "Mathematics Commons Stacks overlay candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "id",
    "namespace",
    "writer",
    "upstream_pin",
    "overlay",
    "manifest",
    "mathematical_entries",
    "content_counts",
    "review_receipt",
    "tests",
    "revision",
    "boundaries"
  ],
  "properties": {
    "schema": {
      "const": "stacks-overlay-entry/v1"
    },
    "state": {
      "const": "candidate_unregistered"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "namespace": {
      "$ref": "#/$defs/namespace"
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "repository",
        "scope_receipt"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repository": {
          "$ref": "#/$defs/https_uri"
        },
        "scope_receipt": {
          "$ref": "#/$defs/file_identity"
        }
      }
    },
    "upstream_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "repository",
        "commit",
        "tree",
        "license_sha256"
      ],
      "properties": {
        "receipt": {
          "$ref": "#/$defs/file_identity"
        },
        "repository": {
          "const": "https://github.com/stacks/stacks-project"
        },
        "commit": {
          "$ref": "#/$defs/git_oid"
        },
        "tree": {
          "$ref": "#/$defs/git_oid"
        },
        "license_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree",
        "root",
        "git_identity_verified"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/https_uri"
        },
        "commit": {
          "$ref": "#/$defs/git_oid"
        },
        "tree": {
          "$ref": "#/$defs/git_oid"
        },
        "root": {
          "$ref": "#/$defs/namespace"
        },
        "git_identity_verified": {
          "const": false
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "content_tree_sha256",
        "members"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "members": {
          "$ref": "#/$defs/positive_integer"
        }
      }
    },
    "mathematical_entries": {
      "$ref": "#/$defs/positive_integer"
    },
    "content_counts": {
      "$ref": "#/$defs/content_counts"
    },
    "review_receipt": {
      "$ref": "#/$defs/pass_receipt"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "bytes",
          "sha256",
          "status",
          "errors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "bytes": {
            "$ref": "#/$defs/nonnegative_integer"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "const": "PASS"
          },
          "errors": {
            "$ref": "#/$defs/empty_array"
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessors",
        "supersedes",
        "reversals"
      ],
      "properties": {
        "predecessors": {
          "$ref": "#/$defs/string_array"
        },
        "supersedes": {
          "$ref": "#/$defs/string_array"
        },
        "reversals": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered",
        "composition_ready",
        "composition_executed",
        "modified_edition",
        "mathematical_certification_claimed",
        "upstream_approval_claimed",
        "upstream_endorsement_implied"
      ],
      "properties": {
        "registered": {
          "const": false
        },
        "composition_ready": {
          "const": false
        },
        "composition_executed": {
          "const": false
        },
        "modified_edition": {
          "const": false
        },
        "mathematical_certification_claimed": {
          "const": false
        },
        "upstream_approval_claimed": {
          "const": false
        },
        "upstream_endorsement_implied": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "member_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "entry_id",
        "namespace",
        "path_order",
        "canonical_stream",
        "self_excluding",
        "members",
        "aggregate"
      ],
      "properties": {
        "schema": {
          "const": "stacks-overlay-files/v1"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "path_order": {
          "const": "ordinal_utf8_bytes"
        },
        "canonical_stream": {
          "const": "path NUL bytes NUL sha256 LF"
        },
        "self_excluding": {
          "const": true
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "aggregate": {
          "$ref": "#/$defs/member_aggregate"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "kind",
        "media_type",
        "stable_ids",
        "languages",
        "upstream_locators",
        "historical_source_locators",
        "provenance_receipts",
        "supersedes",
        "rights_notice"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": [
            "original_additions",
            "historical_source_mappings",
            "provenance",
            "corrections",
            "multilingual_semantic_links",
            "stable_commons_ids",
            "tests",
            "review_receipts"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "stable_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_commons_id"
          }
        },
        "languages": {
          "$ref": "#/$defs/string_array"
        },
        "upstream_locators": {
          "$ref": "#/$defs/string_array"
        },
        "historical_source_locators": {
          "$ref": "#/$defs/string_array"
        },
        "provenance_receipts": {
          "$ref": "#/$defs/string_array"
        },
        "supersedes": {
          "$ref": "#/$defs/string_array"
        },
        "rights_notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "member_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes",
        "content_tree_sha256",
        "stable_ids",
        "mathematical_entries",
        "content_counts"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/positive_integer"
        },
        "bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "content_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stable_ids": {
          "$ref": "#/$defs/positive_integer"
        },
        "mathematical_entries": {
          "$ref": "#/$defs/positive_integer"
        },
        "content_counts": {
          "$ref": "#/$defs/content_counts"
        }
      }
    },
    "scope_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "errors",
        "entry_id",
        "namespace",
        "writer",
        "overlay_repository",
        "overlay_commit",
        "overlay_tree",
        "scope"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "const": "PASS"
        },
        "errors": {
          "$ref": "#/$defs/empty_array"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "writer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "overlay_repository": {
          "$ref": "#/$defs/https_uri"
        },
        "overlay_commit": {
          "$ref": "#/$defs/git_oid"
        },
        "overlay_tree": {
          "$ref": "#/$defs/git_oid"
        },
        "scope": {
          "const": "writer_scope_and_namespace_attestation_not_mathematical_certification"
        }
      }
    },
    "review_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "errors",
        "entry_id",
        "namespace",
        "upstream_commit",
        "overlay_commit",
        "overlay_tree",
        "subject_tree_sha256",
        "scope"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "const": "PASS"
        },
        "errors": {
          "$ref": "#/$defs/empty_array"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "upstream_commit": {
          "$ref": "#/$defs/git_oid"
        },
        "overlay_commit": {
          "$ref": "#/$defs/git_oid"
        },
        "overlay_tree": {
          "$ref": "#/$defs/git_oid"
        },
        "subject_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scope": {
          "const": "bounded_candidate_entry_review_not_mathematical_certification"
        }
      }
    },
    "test_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "errors",
        "entry_id",
        "namespace",
        "upstream_commit",
        "overlay_commit",
        "overlay_tree",
        "subject_tree_sha256"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "const": "PASS"
        },
        "errors": {
          "$ref": "#/$defs/empty_array"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "upstream_commit": {
          "$ref": "#/$defs/git_oid"
        },
        "overlay_commit": {
          "$ref": "#/$defs/git_oid"
        },
        "overlay_tree": {
          "$ref": "#/$defs/git_oid"
        },
        "subject_tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "stable_commons_id": {
      "type": "string",
      "pattern": "^MC-STX-[A-Z0-9](?:[A-Z0-9._-]{0,94}[A-Z0-9_-])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "https_uri": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 500
    },
    "namespace": {
      "type": "string",
      "pattern": "^commons/stacks/[a-z0-9](?:[a-z0-9._-]*[a-z0-9_-])?(?:/[a-z0-9](?:[a-z0-9._-]*[a-z0-9_-])?)*$",
      "maxLength": 240
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "empty_array": {
      "type": "array",
      "maxItems": 0
    },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pass_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "status",
        "errors",
        "scope"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "const": "PASS"
        },
        "errors": {
          "$ref": "#/$defs/empty_array"
        },
        "scope": {
          "const": "bounded_candidate_entry_review_not_mathematical_certification"
        }
      }
    },
    "content_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_additions",
        "historical_source_mappings",
        "provenance",
        "corrections",
        "multilingual_semantic_links",
        "stable_commons_ids",
        "tests",
        "review_receipts"
      ],
      "properties": {
        "original_additions": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "historical_source_mappings": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "provenance": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "corrections": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "multilingual_semantic_links": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "stable_commons_ids": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "tests": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "review_receipts": {
          "$ref": "#/$defs/nonnegative_integer"
        }
      }
    }
  }
}
