      "const": "no_certification_asserted"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "evidence_base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts"
    },
    "human_board": {
      "const": "docs/adopt.md"
    },
    "human_index": {
      "const": "docs/adopt-index.md"
    },
    "archive_authority": {
      "type": "object",
