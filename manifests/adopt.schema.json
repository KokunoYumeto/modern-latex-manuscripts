        "issues"
      ],
      "properties": {
        "board": {
          "type": "array",
          "prefixItems": [
            { "const": "raw_github" },
            { "const": "local_git_object_database" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "issues": {
          "type": "array",
          "prefixItems": [
            { "const": "public_github_api" },
            { "const": "json_fixture" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "claim_execution": {
      "type": "object",
      "required": [
