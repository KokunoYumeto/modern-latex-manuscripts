      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "mirrors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mirror"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "coverageClass": {
      "description": "Coarse storage and coverage state for the exact board-row scope; never a correctness or certification claim.",
      "oneOf": [
        { "const": "complete", "description": "The declared bounded target scope is stored terminally, although review may remain open." },
        { "const": "active", "description": "Substantive current bytes form a maintained moving generation or frontier without a stable terminal claim." },
        { "const": "partial", "description": "One coherent bounded subset exists and an identifiable layer or continuation remains." },
        { "const": "scattered", "description": "Substantive bytes exist across uneven, heterogeneous, or conflicting surfaces without one common frontier." },
        { "const": "weak", "description": "A nominal target surface exists with a material source, custody, control, assembly, or provenance defect or absence." },
        { "const": "source_only", "description": "Source-intake or editable target-source bytes exist without a matching promoted direct reader for this row." },
        { "const": "unworked", "description": "No exact work bytes are bound for this row after reconciliation of its declared evidence surfaces." }
      ]
    },
    "sourceIdentity": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      },
      "additionalProperties": false
    },
    "pathOrNull": {
      "type": ["string", "null"],
      "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).*$"
    },
    "pathArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "uniqueItems": true
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "start_when",
        "inputs",
        "steps",
        "evidence",
        "stop_conditions",
        "handback"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "purpose": { "type": "string", "minLength": 1 },
        "start_when": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "handback": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "author",
        "work",
        "series",
        "corpus",
        "lane_state",
        "coverage_state",
        "coverage_class",
        "adoption_status",
        "priority",
        "readiness",
        "owner",
        "owner_scope",
        "languages",
        "archive_path",
        "related_paths",
        "source_basis",
        "next_cursor",
        "prerequisites",
        "workflow",
        "claim_url",
        "updated",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "author": { "type": "string", "minLength": 1 },
        "work": { "type": "string", "minLength": 1 },
        "series": { "type": ["string", "null"] },
        "corpus": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "lane_state": { "enum": ["current_work", "ready_for_adoption", "future"] },
        "coverage_state": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "coverage_class": { "$ref": "#/$defs/coverageClass" },
        "adoption_status": {
          "enum": [
            "maintained_parallel_review_welcome",
            "open_parallel_mirrors_welcome",
            "claimed_active_parallel_mirrors_welcome",
            "paused_open_for_handoff",
            "future_evidence_needed"
          ]
        },
        "priority": { "enum": ["high", "medium", "exploratory"] },
        "readiness": {
          "enum": [
            "active",
            "exact_cursor",
            "repair_ready",
            "review_ready",
            "expansion_ready",
            "continuation_ready",
            "intake_ready",
            "source_discovery_first"
          ]
        },
        "owner": { "type": ["string", "null"] },
        "owner_scope": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "archive_path": { "$ref": "#/$defs/pathOrNull" },
        "related_paths": { "$ref": "#/$defs/pathArray" },
        "source_basis": { "type": "string", "minLength": 1 },
        "next_cursor": { "type": "string", "minLength": 1 },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "workflow": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
        },
        "claim_url": { "type": "string", "format": "uri" },
        "updated": { "type": "string", "format": "date" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "lane_state": { "const": "current_work" } } },
          "then": {
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "readiness": { "const": "active" },
              "adoption_status": { "const": "maintained_parallel_review_welcome" },
              "owner_scope": { "type": "string", "not": { "pattern": "^unclaimed(?: |$)" } }
            }
          }
        },
        {
          "if": { "properties": { "lane_state": { "const": "ready_for_adoption" } } },
          "then": {
            "properties": {
              "archive_path": { "type": "string", "minLength": 1 },
              "owner": { "type": "null" },
              "adoption_status": { "const": "open_parallel_mirrors_welcome" },
              "owner_scope": { "type": "string", "pattern": "^unclaimed(?: |$)" }
            }
          }
        },
        {
          "if": { "properties": { "lane_state": { "const": "future" } } },
          "then": {
            "properties": {
              "owner": { "type": "null" },
              "adoption_status": { "const": "future_evidence_needed" },
              "readiness": { "const": "source_discovery_first" },
              "owner_scope": { "type": "string", "pattern": "^unclaimed(?: |$)" }
            }
          }
        },
        {
          "if": {
            "properties": { "id": { "const": "stacks-commons-layer" } },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "claim_url": {
                "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts/issues/new?template=stacks.yml"
              }
            }
          },
          "else": {
            "properties": {
              "claim_url": {
                "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts/issues/new?template=adopt.yml"
              }
            }
          }
        }
      ]
    },
    "mirror": {
      "type": "object",
      "required": ["id", "item_id", "owner", "scope", "url", "status", "updated"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "item_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "owner": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "status": { "enum": ["declared", "active", "returned", "paused", "withdrawn"] },
        "updated": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    }
  }
}
