        "intake_form": { "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts/issues/new?template=stacks.yml" },
        "governance": { "const": "mathematics_commons_independent" },
        "upstream": {
          "type": "object",
          "required": ["role", "repository_url", "official_source_page", "default_branch", "commit", "tree", "license_path", "license_identity", "license_sha256", "pin_status", "local_upstream_tree_copied", "acceptance_dependency", "endorsement_implied"],
          "properties": {
            "role": { "const": "respected_pinned_read_only_source_and_sync_target" },
            "repository_url": { "const": "https://github.com/stacks/stacks-project" },
            "official_source_page": { "const": "https://stacks.math.columbia.edu/contribute" },
            "default_branch": { "const": "master" },
            "commit": { "const": "a04446e57ec1fbc252a871afcec7752fb2807b14" },
            "tree": { "const": "3feeb703b931a6e7259782c10e7d1575adc83e5e" },
            "license_path": { "const": "COPYING" },
            "license_identity": { "const": "GNU Free Documentation License Version 1.2, November 2002" },
            "license_sha256": { "const": "4B2C8FC390F802CD92F0622DC00A708A588BEC54D0145D2EE135D6D7672BFE85" },
            "pin_status": { "const": "exact_reference_pin_bound" },
            "local_upstream_tree_copied": { "const": false },
            "acceptance_dependency": { "const": false },
            "endorsement_implied": { "const": false }
          },
          "additionalProperties": false
        },
        "layer_order": {
          "type": "array",
          "prefixItems": [
            { "const": "upstream_pin" },
            { "const": "commons_overlay" },
            { "const": "composed_build" },
            { "const": "optional_modified_edition" },
            { "const": "periodic_upstream_sync" }
