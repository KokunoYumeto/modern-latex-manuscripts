        "modified_edition": {
          "type": "object",
          "required": ["optional", "license", "distinct_title_required", "attribution_required", "license_and_history_notices_required", "upstream_endorsement_forbidden"],
          "properties": {
            "optional": { "const": true },
            "license": { "const": "GFDL_compliant" },
            "distinct_title_required": { "const": true },
            "attribution_required": { "const": true },
            "license_and_history_notices_required": { "const": true },
            "upstream_endorsement_forbidden": { "const": true }
          },
          "additionalProperties": false
