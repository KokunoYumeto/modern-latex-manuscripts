                "version": { "const": "1.0.0" },
                "bytes": { "const": 33847 },
                "sha256": { "const": "FA621C4A38E324B87A69FB75F8DA34B529E71F068838D557B06C45001C6B854B" },
                "defined_cases": { "const": 54 },
                "required_cases": { "const": 53 }
