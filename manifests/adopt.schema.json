        "named_owner_required_for": {
          "type": "array",
          "prefixItems": [
            { "const": "current_work" }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "null_owner_means": { "const": "unclaimed" },
        "null_owner_allowed_for": {
          "type": "array",
          "prefixItems": [
            { "const": "ready_for_adoption" },
            { "const": "future" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "unclaimed_scope_prefix": { "const": "unclaimed" },
        "claims_are_nonexclusive": { "const": true },
        "ready_for_adoption_reason": { "const": "current_project_compute_not_allocated" },
        "future_reason": { "const": "source_or_cursor_evidence_not_yet_bound" },
        "absence_inference_forbidden": { "const": true }
      },
      "additionalProperties": false
    },
    "stacks_reference_layer": {
      "type": "object",
      "required": [
        "status",
        "human_spec",
        "intake_form",
        "governance",
        "upstream",
        "layer_order",
        "overlay_contents",
        "overlay_registry",
        "candidate_entry_contract",
        "composition_contract",
        "modified_edition",
        "compatibility_targets",
        "predecessor_handoff_assertion",
        "write_boundary"
      ],
      "properties": {
        "status": { "const": "pin_registry_preflight_entry_contract_bound_no_overlay_or_build" },
