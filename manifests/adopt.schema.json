              "properties": {
                "path": { "const": "scripts/check-stacks-entry.py" },
                "version": { "const": "1.0.0" },
                "bytes": { "const": 36566 },
                "sha256": { "const": "4E6958C75EB6AB9CDB14CA69C05DEBD1A45E49CE6A75FBA6292DAE1FCD48243D" },
                "success_outcome": { "const": "VALID_CANDIDATE_UNREGISTERED" },
