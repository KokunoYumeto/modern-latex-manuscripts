        "executable_paths",
        "same_commit_required",
        "human_approved_checker_required",
        "helper_materialization",
        "local_script_comparison_role",
        "offline_git_requirement"
      ],
      "properties": {
        "ingestion_snapshot_files": { "const": 4 },
        "executable_paths": {
          "type": "array",
          "prefixItems": [
            { "const": "scripts/get-adopt.py" },
            { "const": "scripts/check-claims.py" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "same_commit_required": { "const": true },
        "human_approved_checker_required": { "const": true },
        "helper_materialization": { "const": "private_exact_commit_blob" },
        "local_script_comparison_role": { "const": "drift_detection_not_trust_root" },
        "offline_git_requirement": {
          "const": "fully_materialized_objects_with_lazy_fetch_disabled_or_network_isolation"
        }
      },
      "additionalProperties": false
    },
    "claim_regression": {
      "const": "scripts/test-claims.py"
    },
    "continuous_validation": {
      "type": "object",
      "required": [
        "workflow",
        "checkout",
        "events",
        "checks",
        "pinned_actions",
        "corpus_builds"
      ],
      "properties": {
        "workflow": { "const": ".github/workflows/adopt.yml" },
        "checkout": { "const": "blobless_sparse_metadata" },
        "events": {
          "type": "array",
          "prefixItems": [
            { "const": "pull_request" },
            { "const": "push_main" },
            { "const": "workflow_dispatch" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "checks": {
          "type": "array",
          "prefixItems": [
            { "const": "board_schema_maps" },
            { "const": "exact_local_consumer" },
            { "const": "promisor_no_lazy_fetch" },
            { "const": "claim_lifecycle_fixtures" },
            { "const": "stacks_preflight_fixture" },
            { "const": "stacks_entry_fixture" }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "pinned_actions": { "const": true },
        "corpus_builds": { "const": false }
      },
      "additionalProperties": false
    },
    "claim_interface": {
      "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts/issues/new?template=adopt.yml"
    },
    "handback_interface": {
      "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts/issues/new?template=handback.yml"
    },
    "human_workflows": {
      "const": "docs/adopt-flows.md"
    },
    "workflow_fields": {
      "type": "array",
      "prefixItems": [
        { "const": "id" },
        { "const": "purpose" },
        { "const": "start_when" },
        { "const": "inputs" },
        { "const": "steps" },
        { "const": "evidence" },
        { "const": "stop_conditions" },
        { "const": "handback" }
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "enums": {
      "type": "object",
      "required": [
        "lane_state",
        "coverage_class",
        "priority",
        "readiness",
        "adoption_status",
        "mirror_status"
      ],
      "properties": {
        "lane_state": {
          "type": "array",
          "items": {
            "enum": ["current_work", "ready_for_adoption", "future"]
          },
          "uniqueItems": true
        },
        "coverage_class": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverageClass" },
          "uniqueItems": true
        },
        "priority": {
          "type": "array",
          "items": {
            "enum": ["high", "medium", "exploratory"]
          },
          "uniqueItems": true
        },
        "readiness": {
          "type": "array",
          "items": {
            "enum": [
              "active",
              "exact_cursor",
              "repair_ready",
              "review_ready",
              "expansion_ready",
              "continuation_ready",
              "intake_ready",
              "source_discovery_first"
            ]
          },
          "uniqueItems": true
        },
        "adoption_status": {
          "type": "array",
          "items": {
            "enum": [
              "maintained_parallel_review_welcome",
              "open_parallel_mirrors_welcome",
              "claimed_active_parallel_mirrors_welcome",
              "paused_open_for_handoff",
              "future_evidence_needed"
            ]
          },
          "uniqueItems": true
        },
        "mirror_status": {
          "type": "array",
          "items": {
            "enum": ["declared", "active", "returned", "paused", "withdrawn"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "prefixItems": [
        { "const": "id" },
        { "const": "author" },
        { "const": "work" },
        { "const": "series" },
        { "const": "corpus" },
        { "const": "lane_state" },
        { "const": "coverage_state" },
        { "const": "coverage_class" },
        { "const": "adoption_status" },
        { "const": "priority" },
        { "const": "readiness" },
        { "const": "owner" },
        { "const": "owner_scope" },
        { "const": "languages" },
        { "const": "archive_path" },
        { "const": "related_paths" },
        { "const": "source_basis" },
        { "const": "next_cursor" },
        { "const": "prerequisites" },
        { "const": "workflow" },
        { "const": "claim_url" },
        { "const": "updated" },
        { "const": "notes" }
