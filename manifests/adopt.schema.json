                "sha256": { "const": "89B3ED1093ABDF097E7FE6EF8A99E3728B276C4F04733D5CFA14CA9404295CCA" }
              },
              "additionalProperties": false
            },
            "preflight_result": {
              "type": "object",
              "required": ["path", "bytes", "sha256"],
              "properties": {
                "path": { "const": "manifests/stacks-preflight.json" },
                "bytes": { "const": 3729 },
                "sha256": { "const": "7AE74076674674C90B1956A448D6A0CBA9665099FA476AF51AEF679E534B5E34" }
              },
              "additionalProperties": false
            },
            "executable_preflight_runs": { "const": 1 },
            "composition_tool_state": { "const": "not_bound" },
            "composition_runs": { "const": 0 },
            "generated_members": { "const": 0 },
