{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KokunoYumeto/modern-latex-manuscripts/main/manifests/adopt.schema.json",
  "title": "Mathematics Commons adoption board",
  "description": "Operational adoption and mirror metadata layered on top of the authoritative archive maps.",
  "type": "object",
  "required": [
    "schema",
    "schema_url",
    "validation",
    "board_role",
    "updated",
    "evidence_base_commit",
    "repository",
    "human_board",
    "human_index",
    "archive_authority",
    "ownership_policy",
    "map_manifest",
    "required_maps",
    "queue_sources",
    "queue_snapshot",
    "snapshot_policy",
    "consumer_helper",
    "consumer_modes",
    "consumer_regression",
    "claim_auditor",
    "claim_auditor_modes",
    "claim_regression",
    "continuous_validation",
    "claim_interface",
    "handback_interface",
    "human_workflows",
    "workflow_fields",
    "workflows",
    "enums",
    "fields",
    "mirror_fields",
    "mirrors",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "math-commons-adoption-v1"
    },
    "schema_url": {
      "const": "manifests/adopt.schema.json"
    },
    "validation": {
      "const": "manifests/adopt.check.json"
    },
    "board_role": {
      "const": "operational_layer"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "evidence_base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts"
    },
    "human_board": {
      "const": "docs/adopt.md"
    },
    "human_index": {
      "const": "docs/adopt-index.md"
    },
    "archive_authority": {
      "type": "object",
      "required": [
        "coverage_maps",
        "reader_shelf",
        "source_shelf",
        "archive_history"
      ],
      "properties": {
        "coverage_maps": { "type": "string" },
        "reader_shelf": { "type": "string" },
        "source_shelf": { "type": "string" },
        "archive_history": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ownership_policy": {
      "type": "object",
      "required": [
        "named_owner_required_for",
        "null_owner_means",
        "null_owner_allowed_for",
        "unclaimed_scope_prefix",
        "claims_are_nonexclusive"
      ],
      "properties": {
        "named_owner_required_for": {
          "type": "array",
          "prefixItems": [
            { "const": "current_work" }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "null_owner_means": { "const": "unclaimed" },
        "null_owner_allowed_for": {
          "type": "array",
          "prefixItems": [
            { "const": "ready_for_adoption" },
            { "const": "future" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "unclaimed_scope_prefix": { "const": "unclaimed" },
        "claims_are_nonexclusive": { "const": true }
      },
      "additionalProperties": false
    },
    "map_manifest": {
      "const": "manifests/github-custody/20260807_maps_r5.json"
    },
    "required_maps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docs/[a-z0-9]+(?:-[a-z0-9]+)*-map\\.md$"
      }
    },
    "queue_sources": {
      "type": "array",
      "prefixItems": [
        { "const": "docs/known-gaps.md" },
        { "const": "docs/work-queue.md" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "queue_snapshot": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/sourceIdentity"
      }
    },
    "snapshot_policy": {
      "type": "object",
      "required": [
        "stable_locator_ref",
        "immutable_unit",
        "same_commit_paths",
        "required_checks",
        "mixed_revisions_forbidden"
      ],
      "properties": {
        "stable_locator_ref": { "const": "main" },
        "immutable_unit": { "const": "human_approved_exact_commit" },
        "same_commit_paths": {
          "type": "array",
          "prefixItems": [
            { "const": "manifests/adopt.json" },
            { "const": "manifests/adopt.schema.json" },
            { "const": "manifests/adopt.check.json" },
            { "const": "manifests/github-custody/20260807_maps_r5.json" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "required_checks": {
          "type": "array",
          "prefixItems": [
            { "const": "validation_status_pass" },
            { "const": "validation_errors_empty" },
            { "const": "declared_bytes_sha256_match" },
            { "const": "schema_validation_pass" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "mixed_revisions_forbidden": { "const": true }
      },
      "additionalProperties": false
    },
    "consumer_helper": {
      "const": "scripts/get-adopt.py"
    },
    "consumer_modes": {
      "type": "array",
      "prefixItems": [
        { "const": "raw_github" },
        { "const": "local_git_object_database" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "consumer_regression": {
      "const": "scripts/test-adopt-offline.py"
    },
    "claim_auditor": {
      "const": "scripts/check-claims.py"
    },
    "claim_auditor_modes": {
      "type": "object",
      "required": [
        "board",
        "issues"
      ],
      "properties": {
        "board": {
          "type": "array",
          "prefixItems": [
            { "const": "raw_github" },
            { "const": "local_git_object_database" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "issues": {
          "type": "array",
          "prefixItems": [
            { "const": "public_github_api" },
            { "const": "json_fixture" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "claim_regression": {
      "const": "scripts/test-claims.py"
    },
    "continuous_validation": {
      "type": "object",
      "required": [
        "workflow",
        "checkout",
        "events",
        "checks",
        "pinned_actions",
        "corpus_builds"
      ],
      "properties": {
        "workflow": { "const": ".github/workflows/adopt.yml" },
        "checkout": { "const": "blobless_sparse_metadata" },
        "events": {
          "type": "array",
          "prefixItems": [
            { "const": "pull_request" },
            { "const": "push_main" },
            { "const": "workflow_dispatch" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "checks": {
          "type": "array",
          "prefixItems": [
            { "const": "board_schema_maps" },
            { "const": "exact_local_consumer" },
            { "const": "promisor_no_lazy_fetch" },
            { "const": "claim_lifecycle_fixtures" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "pinned_actions": { "const": true },
        "corpus_builds": { "const": false }
      },
      "additionalProperties": false
    },
    "claim_interface": {
      "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts/issues/new?template=adopt.yml"
    },
    "handback_interface": {
      "const": "https://github.com/KokunoYumeto/modern-latex-manuscripts/issues/new?template=handback.yml"
    },
    "human_workflows": {
      "const": "docs/adopt-flows.md"
    },
    "workflow_fields": {
      "type": "array",
      "prefixItems": [
        { "const": "id" },
        { "const": "purpose" },
        { "const": "start_when" },
        { "const": "inputs" },
        { "const": "steps" },
        { "const": "evidence" },
        { "const": "stop_conditions" },
        { "const": "handback" }
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "enums": {
      "type": "object",
      "required": [
        "lane_state",
        "priority",
        "readiness",
        "adoption_status",
        "mirror_status"
      ],
      "properties": {
        "lane_state": {
          "type": "array",
          "items": {
            "enum": ["current_work", "ready_for_adoption", "future"]
          },
          "uniqueItems": true
        },
        "priority": {
          "type": "array",
          "items": {
            "enum": ["high", "medium", "exploratory"]
          },
          "uniqueItems": true
        },
        "readiness": {
          "type": "array",
          "items": {
            "enum": [
              "active",
              "exact_cursor",
              "repair_ready",
              "review_ready",
              "expansion_ready",
              "continuation_ready",
              "intake_ready",
              "source_discovery_first"
            ]
          },
          "uniqueItems": true
        },
        "adoption_status": {
          "type": "array",
          "items": {
            "enum": [
              "maintained_parallel_review_welcome",
              "open_parallel_mirrors_welcome",
              "claimed_active_parallel_mirrors_welcome",
              "paused_open_for_handoff",
              "future_evidence_needed"
            ]
          },
          "uniqueItems": true
        },
        "mirror_status": {
          "type": "array",
          "items": {
            "enum": ["declared", "active", "returned", "paused", "withdrawn"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "prefixItems": [
        { "const": "id" },
        { "const": "author" },
        { "const": "work" },
        { "const": "series" },
        { "const": "corpus" },
        { "const": "lane_state" },
        { "const": "coverage_state" },
        { "const": "adoption_status" },
        { "const": "priority" },
        { "const": "readiness" },
        { "const": "owner" },
        { "const": "owner_scope" },
        { "const": "languages" },
        { "const": "archive_path" },
        { "const": "related_paths" },
        { "const": "source_basis" },
        { "const": "next_cursor" },
        { "const": "prerequisites" },
        { "const": "workflow" },
        { "const": "claim_url" },
        { "const": "updated" },
        { "const": "notes" }
      ],
      "items": false,
      "minItems": 22,
      "maxItems": 22
    },
    "mirror_fields": {
      "type": "array",
      "prefixItems": [
        { "const": "id" },
        { "const": "item_id" },
        { "const": "owner" },
        { "const": "scope" },
        { "const": "url" },
        { "const": "status" },
        { "const": "updated" }
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "mirrors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mirror"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sourceIdentity": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      },
      "additionalProperties": false
    },
    "pathOrNull": {
      "type": ["string", "null"],
      "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).*$"
    },
    "pathArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "uniqueItems": true
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "start_when",
        "inputs",
        "steps",
        "evidence",
        "stop_conditions",
        "handback"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "purpose": { "type": "string", "minLength": 1 },
        "start_when": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "handback": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "author",
        "work",
        "series",
        "corpus",
        "lane_state",
        "coverage_state",
        "adoption_status",
        "priority",
        "readiness",
        "owner",
        "owner_scope",
        "languages",
        "archive_path",
        "related_paths",
        "source_basis",
        "next_cursor",
        "prerequisites",
        "workflow",
        "claim_url",
        "updated",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "author": { "type": "string", "minLength": 1 },
        "work": { "type": "string", "minLength": 1 },
        "series": { "type": ["string", "null"] },
        "corpus": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "lane_state": { "enum": ["current_work", "ready_for_adoption", "future"] },
        "coverage_state": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "adoption_status": {
          "enum": [
            "maintained_parallel_review_welcome",
            "open_parallel_mirrors_welcome",
            "claimed_active_parallel_mirrors_welcome",
            "paused_open_for_handoff",
            "future_evidence_needed"
          ]
        },
        "priority": { "enum": ["high", "medium", "exploratory"] },
        "readiness": {
          "enum": [
            "active",
            "exact_cursor",
            "repair_ready",
            "review_ready",
            "expansion_ready",
            "continuation_ready",
            "intake_ready",
            "source_discovery_first"
          ]
        },
        "owner": { "type": ["string", "null"] },
        "owner_scope": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "archive_path": { "$ref": "#/$defs/pathOrNull" },
        "related_paths": { "$ref": "#/$defs/pathArray" },
        "source_basis": { "type": "string", "minLength": 1 },
        "next_cursor": { "type": "string", "minLength": 1 },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "workflow": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
        },
        "claim_url": { "type": "string", "format": "uri" },
        "updated": { "type": "string", "format": "date" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "lane_state": { "const": "current_work" } } },
          "then": {
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "readiness": { "const": "active" },
              "adoption_status": { "const": "maintained_parallel_review_welcome" },
              "owner_scope": { "type": "string", "not": { "pattern": "^unclaimed(?: |$)" } }
            }
          }
        },
        {
          "if": { "properties": { "lane_state": { "const": "ready_for_adoption" } } },
          "then": {
            "properties": {
              "archive_path": { "type": "string", "minLength": 1 },
              "owner": { "type": "null" },
              "adoption_status": { "const": "open_parallel_mirrors_welcome" },
              "owner_scope": { "type": "string", "pattern": "^unclaimed(?: |$)" }
            }
          }
        },
        {
          "if": { "properties": { "lane_state": { "const": "future" } } },
          "then": {
            "properties": {
              "owner": { "type": "null" },
              "adoption_status": { "const": "future_evidence_needed" },
              "readiness": { "const": "source_discovery_first" },
              "owner_scope": { "type": "string", "pattern": "^unclaimed(?: |$)" }
            }
          }
        }
      ]
    },
    "mirror": {
      "type": "object",
      "required": ["id", "item_id", "owner", "scope", "url", "status", "updated"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "item_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "owner": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "status": { "enum": ["declared", "active", "returned", "paused", "withdrawn"] },
        "updated": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    }
  }
}
