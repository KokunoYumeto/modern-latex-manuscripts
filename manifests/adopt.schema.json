  "title": "Mathematics Commons adoption board",
  "description": "Operational adoption and mirror metadata layered on top of the authoritative archive maps.",
  "type": "object",
  "required": [
    "schema",
    "schema_url",
    "validation",
    "board_role",
    "item_certification_default",
    "updated",
    "evidence_base_commit",
    "repository",
    "human_board",
    "human_index",
    "archive_authority",
    "ownership_policy",
    "stacks_reference_layer",
    "map_manifest",
    "required_maps",
    "queue_sources",
    "queue_snapshot",
    "snapshot_policy",
    "consumer_helper",
    "consumer_modes",
    "consumer_regression",
    "claim_auditor",
    "claim_auditor_modes",
    "claim_execution",
    "claim_regression",
    "continuous_validation",
    "claim_interface",
    "handback_interface",
    "human_workflows",
    "workflow_fields",
    "workflows",
    "enums",
    "fields",
    "mirror_fields",
    "mirrors",
    "items"
  ],
