{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SGA project-generated visual evidence record",
  "type": "object",
  "required": [
    "schema_version",
    "visual_id",
    "series",
    "kind",
    "publication_disposition",
    "source_type",
    "relative_path",
    "bytes",
    "sha256",
    "width_px",
    "height_px",
    "dpi_x",
    "dpi_y",
    "rotation_degrees",
    "bounding_box_px",
    "parent_artifact_path",
    "parent_artifact_sha256",
    "parent_page",
    "linked_tex_path",
    "linked_structural_unit",
    "review_outputs",
    "qa_disposition",
    "rights_note"
  ],
  "properties": {
    "visual_id": {
      "type": "string",
      "pattern": "^SGA-VIS-"
    },
    "publication_disposition": {
      "const": "open_payload"
    },
    "relative_path": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "width_px": {
      "type": "integer",
      "minimum": 1
    },
    "height_px": {
      "type": "integer",
      "minimum": 1
    },
    "rotation_degrees": {
      "const": 0
    },
    "bounding_box_px": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "qa_disposition": {
      "const": "accepted_no_visible_defect"
    }
  },
  "additionalProperties": true
}
