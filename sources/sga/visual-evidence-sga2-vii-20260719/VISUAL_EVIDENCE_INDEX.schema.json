{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual evidence index row",
  "type": "object",
  "required": [
    "stable_id",
    "relative_path",
    "role",
    "bytes",
    "sha256",
    "width_px",
    "height_px",
    "linked_structural_id",
    "qa_disposition",
    "rights_disposition"
  ],
  "properties": {
    "stable_id": {"type": "string", "minLength": 1},
    "relative_path": {"type": "string", "minLength": 1},
    "role": {"type": "string", "enum": ["target_pdf_render", "machine_ledger_preview", "contact_sheet"]},
    "bytes": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "width_px": {"type": "integer", "minimum": 1},
    "height_px": {"type": "integer", "minimum": 1},
    "dpi_x": {"type": ["number", "null"]},
    "dpi_y": {"type": ["number", "null"]},
    "rotation_degrees": {"type": "integer"},
    "crop_bbox_px": {"type": "string"},
    "parent_artifact": {"type": "string"},
    "parent_sha256": {"type": "string"},
    "page_or_view": {"type": "string"},
    "linked_structural_id": {"type": "string"},
    "qa_disposition": {"type": "string"},
    "rights_disposition": {"type": "string"}
  },
  "additionalProperties": false
}
