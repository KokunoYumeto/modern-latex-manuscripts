& - 12\cdot bc^2gh^2l^2 + 18\cdot bcgh^2jk + 60\cdot cf^2hj^2kl + 36\cdot fh^2ij^2 - 12\cdot a^2b^2c^2fi + 4\cdot ac^2f^2i^2\\
& - 12\cdot bc^2gh^2jk + 36\cdot bch^3j^2 - 12\cdot cf^2h^3l^2 + 24\cdot c^2gh^3m + \ldots \pm 54
\end{align*}

