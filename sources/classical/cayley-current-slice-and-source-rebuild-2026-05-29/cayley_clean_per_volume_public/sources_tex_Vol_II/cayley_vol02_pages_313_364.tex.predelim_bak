& - 3\cdot abc^3k\cdot\xi^4\zeta - 3\cdot a^2bc^2l\cdot\xi^4\eta - 3\cdot ab^2c^2g\cdot\xi^3\eta\zeta - 3\cdot a^2b^2c^2h\cdot\xi^3\eta\zeta\\
& - 3\cdot abc^2fj\cdot\xi^3\eta\zeta + 6\cdot abc^2fi\cdot\xi^3\eta\zeta - 6\cdot a^2c^2fi\cdot\xi^4\zeta + 3\cdot a^2bf^2i\cdot\xi^3\zeta^2\\
