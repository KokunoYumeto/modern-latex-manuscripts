\begin{align*}
\Theta_3 U &= -2(1 + 3l^2)(yz^2 + z^2x + x^2y) + (1 - 9l^2)(x^3 + y^3 + z^3)\\
&\quad + (3l - 180l^2 + 96l^3)(x^2 + y^2 + z^2)xyz + (3l^2 - 624l^3 + 432l^4)xyz + \ldots
