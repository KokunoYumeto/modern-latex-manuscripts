\renewcommand{\headrulewidth}{0pt}

% Section formatting - paper numbers
\titleformat{\section}
  {\centering\large\scshape}
  {}{0em}{}
\titlespacing*{\section}{0pt}{2em}{1em}

\titleformat{\subsection}
  {\centering\normalsize\scshape}
  {}{0em}{}
\titlespacing*{\subsection}{0pt}{1em}{0.5em}

% Custom commands for Cayley's notation
\newcommand{\paperref}[1]{\par\noindent\hfill[#1]\hfill\null\par}
\newcommand{\source}[1]{\par\noindent\centering[#1]\par\medskip}

% Theorem-like environments
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}{Lemma}
\newtheorem{corollary}{Corollary}

\theoremstyle{definition}
\newtheorem{definition}{Definition}

\theoremstyle{remark}
\newtheorem*{remark}{Remark}

% Define Cayley's 'between' notation for polynomials
\let\origbetween\between
\renewcommand{\between}{\,\wr\,}

% Shortcuts for common notation in Cayley's papers
\newcommand{\ph}{\varphi}
\newcommand{\dprime}{\prime\prime}
\newcommand{\tprime}{\prime\prime\prime}
\DeclareMathOperator{\const}{const.}

