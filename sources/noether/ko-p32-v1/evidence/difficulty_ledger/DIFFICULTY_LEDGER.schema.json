{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.interlanguage.invalid/schemas/noether-p32-korean-translation-difficulty-ledger-1.0.0.json",
  "title": "Noether Paper 32 Korean translation-producer difficulty and failure record",
  "description": "One append-only JSONL record per hard unit, failed or rejected approach, unresolved terminology risk, metadata ambiguity, or transport failure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "recorded_at",
    "occurrence_time",
    "work_unit",
    "structural_ids",
    "source_locator",
    "target_locator",
    "difficulty_class",
    "symptom",
    "severity",
    "discovery_channel",
    "cause",
    "attempted_approaches",
    "resolution_state",
    "resolution_or_workaround",
    "evidence_artifacts",
    "residual_risk",
    "recurrence_cues",
    "transferable_lesson",
    "future_check",
    "related_decision_ids",
    "changed_artifacts",
    "supersedes",
    "supersession_state",
    "continuation_or_revisit"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "issue_id": {"type": "string", "pattern": "^CJK-KO-P32-HARD-[0-9]{3}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "occurrence_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "precision"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "precision": {"enum": ["exact", "minute", "date_only", "bounded_unknown"]}
      }
    },
    "work_unit": {"type": "string", "minLength": 1},
    "structural_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "source_locator": {"type": "string", "minLength": 1},
    "target_locator": {"type": "string", "minLength": 1},
    "difficulty_class": {"type": "string", "minLength": 1},
    "symptom": {"type": "string", "minLength": 1},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "discovery_channel": {"type": "string", "minLength": 1},
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "inference"],
      "properties": {
        "evidence": {"type": "string", "minLength": 1},
        "inference": {"type": "string", "minLength": 1}
      }
    },
    "attempted_approaches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approach", "outcome", "evidence"],
        "properties": {
          "approach": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["failed", "rejected", "partial", "resolved", "workaround", "held"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "resolution_state": {"enum": ["resolved", "workaround", "held", "unresolved", "superseded"]},
    "resolution_or_workaround": {"type": "string", "minLength": 1},
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_or_reference", "hash_or_test", "role"],
        "properties": {
          "path_or_reference": {"type": "string", "minLength": 1},
          "hash_or_test": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "residual_risk": {"type": "string", "minLength": 1},
    "recurrence_cues": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "transferable_lesson": {"type": "string", "minLength": 1},
    "future_check": {"type": "string", "minLength": 1},
    "related_decision_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "changed_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersession_state": {"enum": ["active", "corrects_prior", "superseded", "not_applicable"]},
    "continuation_or_revisit": {"type": "string", "minLength": 1}
  }
}
