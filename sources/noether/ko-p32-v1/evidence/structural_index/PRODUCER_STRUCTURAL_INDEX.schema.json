{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.interlanguage.invalid/schemas/noether-p32-korean-producer-structural-index-1.0.0.json",
  "title": "Noether Paper 32 Korean translation-producer structural record",
  "description": "One JSONL object per work, routed translation unit, or machine-extracted structural component. Internal source-target correspondence is ordinal-by-type and remains unreviewed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "structural_id",
    "work_id",
    "unit_type",
    "title",
    "parent_id",
    "order",
    "authority",
    "targets",
    "relations",
    "completion_state",
    "review_state",
    "publication_state",
    "continuation_cursor",
    "boundary_confidence",
    "ambiguity",
    "decision_ids",
    "touched_at",
    "supersedes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "structural_id": {"type": "string", "pattern": "^NOE-P32-KO-(WORK|U[0-9]{2}(-[A-Z]+-[0-9]{3})?)$"},
    "work_id": {"const": "noether.paper32.ko.translation_producer"},
    "unit_type": {
      "enum": [
        "work",
        "translation_unit",
        "section",
        "paragraph",
        "closed_prose_unit",
        "equation_display",
        "note",
        "bibliography_item",
        "other"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "parent_id": {"type": ["string", "null"]},
    "order": {"type": "integer", "minimum": 0},
    "authority": {"$ref": "#/$defs/authoritySide"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/targetSide"}},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_id"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "completion_state": {"enum": ["draft_text_coverage", "translated_draft", "held"]},
    "review_state": {"const": "unreviewed"},
    "publication_state": {"const": "private_working"},
    "continuation_cursor": {"type": "string", "minLength": 1},
    "boundary_confidence": {"enum": ["high", "medium", "low"]},
    "ambiguity": {"type": ["string", "null"]},
    "decision_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "touched_at": {"type": "string", "minLength": 1},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "global_line_start",
        "global_line_end",
        "local_line_start",
        "local_line_end",
        "char_start",
        "char_end"
      ],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "global_line_start": {"type": ["integer", "null"], "minimum": 1},
        "global_line_end": {"type": ["integer", "null"], "minimum": 1},
        "local_line_start": {"type": ["integer", "null"], "minimum": 1},
        "local_line_end": {"type": ["integer", "null"], "minimum": 1},
        "char_start": {"type": ["integer", "null"], "minimum": 0},
        "char_end": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "authoritySide": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "locator",
        "sha256",
        "fragment_sha256",
        "language",
        "hash_basis"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "fragment_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "language": {"type": "string", "minLength": 1},
        "hash_basis": {"enum": ["computed", "manager_supplied_unchecked"]}
      }
    },
    "targetSide": {
      "allOf": [
        {"$ref": "#/$defs/authoritySide"},
        {
          "type": "object",
          "required": ["match_method", "confidence", "ambiguity"],
          "properties": {
            "match_method": {"type": "string", "minLength": 1},
            "confidence": {"enum": ["high", "medium", "low", "none"]},
            "ambiguity": {"type": ["string", "null"]}
          }
        }
      ]
    }
  }
}
