          "pattern": "^Noether_Paper21_Japanese_SourceReconciled_v001-[0-9]{2}\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "mime_type": {
          "const": "image/png"
        }
      }
    },
    "source_coordinates": {
