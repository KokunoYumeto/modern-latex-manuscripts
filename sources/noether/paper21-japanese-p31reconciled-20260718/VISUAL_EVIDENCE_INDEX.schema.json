      "properties": {
        "width_px": {
          "const": 1654
        },
        "height_px": {
          "const": 2339
        },
        "dpi_x": {
          "const": 200
        },
        "dpi_y": {
          "const": 200
        },
        "dpi_basis": {
          "const": "embedded_png_pHYs_and_accepted_200_ppi_render_record"
        },
        "rotation_degrees": {
          "const": 0
        },
        "rotation_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "linked_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_authority_tex_path",
        "source_authority_tex_sha256",
        "source_authority_locator",
        "source_authority_span_sha256",
        "target_tex_path",
        "target_tex_sha256",
        "target_pdf_path",
        "target_pdf_sha256",
        "target_pdf_page",
        "extracted_text_path",
        "extracted_text_sha256",
