{
  "$schema": "httpprivate-source/schema",
  "$id": "httpprivate-source/noether-p21-ja-visual-evidence-1.0.0.json",
  "title": "Interlanguage Japanese Noether Paper 21 visual-evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "visual_id",
    "project",
    "lane",
    "work_id",
    "unit_id",
    "language",
    "structural_ids",
    "decision_ids",
    "evidence_role",
    "authority_class",
    "asset",
    "source_coordinates",
    "geometry",
    "linked_artifacts",
    "extraction_or_model_outputs",
    "rejected_readings",
    "review",
    "rights",
    "publication_disposition",
    "continuation_cursor",
    "supersession_relation",
    "supersedes"
