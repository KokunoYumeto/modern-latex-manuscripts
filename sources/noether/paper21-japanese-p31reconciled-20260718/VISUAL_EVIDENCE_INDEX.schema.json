  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "visual_id": {
      "type": "string",
      "pattern": "^VE-NOE-P21-JA-[0-9]{3}$"
    },
    "project": {
      "const": "interlanguage"
    },
    "lane": {
      "const": "CJK-Japanese"
    },
    "work_id": {
      "const": "noether.paper21.ja"
    },
    "unit_id": {
      "const": "P21-JA-ROOT"
    },
    "language": {
