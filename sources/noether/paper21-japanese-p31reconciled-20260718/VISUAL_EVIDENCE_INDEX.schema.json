    "structural_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P21-JA-"
      }
    },
    "decision_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
