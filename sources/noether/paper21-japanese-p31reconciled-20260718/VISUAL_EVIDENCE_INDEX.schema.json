          "const": "BC9F967A46E75BC905F2ED2BBA5F12634C1E62E05F5FFF5F6E941BB31D0E524F"
        },
        "physical_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "printed_page": {
          "type": "string",
          "pattern": "^[1-3]$"
        },
        "source_index": {
          "type": "string",
          "pattern": "^target_pdf_page_[0-9]{3}$"
        },
        "edition_coordinates": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinate_system",
            "x",
            "y",
            "width",
            "height"
