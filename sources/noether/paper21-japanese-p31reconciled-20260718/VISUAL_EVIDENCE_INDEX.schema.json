    },
    "authority_class": {
      "const": "derived_target_output"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "sha256",
        "byte_count",
        "mime_type"
      ],
      "properties": {
        "path": {
