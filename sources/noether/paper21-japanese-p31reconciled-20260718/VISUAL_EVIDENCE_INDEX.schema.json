          "properties": {
            "coordinate_system": {
              "const": "pixels_top_left"
            },
            "x": {
              "const": 0
            },
            "y": {
              "const": 0
            },
            "width": {
              "const": 1654
            },
            "height": {
              "const": 2339
            }
          }
        },
        "parent_dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "unit"
          ],
          "properties": {
            "width": {
              "const": 595.28
            },
            "height": {
              "const": 841.89
            },
            "unit": {
              "const": "pdf_points"
            }
          }
        }
      }
