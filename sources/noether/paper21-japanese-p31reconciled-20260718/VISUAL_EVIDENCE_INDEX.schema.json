        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "source_url_or_public_identifier": {
          "type": "string",
          "minLength": 1
        },
        "parent_asset_name": {
          "const": "Noether_Paper21_Japanese_SourceReconciled_v001.pdf"
        },
        "parent_asset_path": {
          "const": "output/pdf/Noether_Paper21_Japanese_SourceReconciled_v001.pdf"
