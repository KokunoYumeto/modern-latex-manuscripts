      "properties": {
        "source_authority_tex_path": {
          "type": "string",
          "minLength": 1
        },
        "source_authority_tex_sha256": {
          "const": "A48CB5CD1716974B686AC1CBA681CA4B17BC72F9043B78AD2528ACA41FCF814F"
        },
        "source_authority_locator": {
          "const": "DE 12583-12674"
        },
        "source_authority_span_sha256": {
          "const": "21C8472242F1748C64E843DB028441C489D986AC8CA67590D470ABD4318FD8B6"
        },
        "target_tex_path": {
          "const": "Noether_Paper21_Japanese_SourceReconciled_v001.tex"
        },
        "target_tex_sha256": {
          "const": "C8766BF85B516A356649AF5C72CC6B0C09FBDA00078C49DE4E47217907F15F42"
        },
        "target_pdf_path": {
          "const": "output/pdf/Noether_Paper21_Japanese_SourceReconciled_v001.pdf"
        },
        "target_pdf_sha256": {
          "const": "BC9F967A46E75BC905F2ED2BBA5F12634C1E62E05F5FFF5F6E941BB31D0E524F"
        },
        "target_pdf_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "extracted_text_path": {
          "const": "output/pdf/Noether_Paper21_Japanese_SourceReconciled_v001.txt"
        },
        "extracted_text_sha256": {
          "const": "336DC8BE58F5C557A97DED513642927E5B7A1FC4770E66B4E3B77D728D79B7DE"
        },
        "cross_reference_visual_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^VE-NOE-P21-JA-[0-9]{3}$"
          }
        }
      }
    },
    "extraction_or_model_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_readings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "human_review",
        "qa_disposition",
        "residual_uncertainty"
      ],
      "properties": {
        "state": {
          "const": "internally_visual_checked_original_detail"
