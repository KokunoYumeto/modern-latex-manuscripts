{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noether-vi-structure/1",
  "type": "object",
  "required": ["id", "type", "parent_id", "order", "source_authority", "source_relative_lines", "source_authority_lines", "source_sha256", "target_path", "target_lines", "target_sha256", "language", "completion_state", "review_state", "publication_state", "next_cursor"],
  "properties": {
    "id": {"type": "string", "pattern": "^VI-P01-"},
    "type": {"enum": ["title", "paragraph", "note", "bibliography_item", "equation", "table", "theorem", "definition", "list", "list_item"]},
    "parent_id": {"type": ["string", "null"]},
    "order": {"type": "integer", "minimum": 1},
    "source_authority": {"const": "NOETH-DE-ED-0004"},
    "source_relative_lines": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
    "source_authority_lines": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
    "source_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "target_path": {"const": "p01.tex"},
    "target_lines": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
    "target_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "hash_scope": {"type": "string"},
    "language": {"const": "vi"},
    "completion_state": {"const": "translated_draft"},
    "review_state": {"const": "independent_review_pending"},
    "publication_state": {"const": "unpublished"},
    "cross_refs": {"type": "array", "items": {"type": "string"}},
    "next_cursor": {"type": "string"}
  },
  "additionalProperties": true
}
