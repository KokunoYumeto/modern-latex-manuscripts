{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noether rights-aware visual evidence row",
  "type": "object",
  "required": [
    "schema_version",
    "visual_id",
    "package",
    "archive_member",
    "artifact_role",
    "publication_disposition",
    "bytes",
    "sha256",
    "width_px",
    "height_px",
    "parent_document_sha256",
    "linked_structural_unit",
    "qa_disposition",
    "rights_note"
  ],
  "properties": {
    "visual_id": {
      "type": "string",
      "pattern": "^(VE-NOE-P02P04-(OPEN|BLOCKED)|VE-NOE-P04-S07-EN)-[0-9]{3}$"
    },
    "publication_disposition": {
      "enum": [
        "open_payload",
        "manifest_only_rights_blocked"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "width_px": {
      "type": "integer",
      "minimum": 1
    },
    "height_px": {
      "type": "integer",
      "minimum": 1
    },
    "bounding_box_pixels": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4
        }
      ]
    }
  },
  "additionalProperties": true
}
