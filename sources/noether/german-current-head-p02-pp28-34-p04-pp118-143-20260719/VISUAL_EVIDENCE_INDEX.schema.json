{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noether German Paper 2 and Paper 4 target visual record",
  "type": "object",
  "required": [
    "visual_id",
    "relative_path",
    "parent_pdf_sha256",
    "pdf_page",
    "width_px",
    "height_px",
    "generation_dpi",
    "embedded_dpi_x",
    "embedded_dpi_y",
    "rotation_degrees",
    "bounding_box",
    "sha256",
    "bytes",
    "linked_structural_unit",
    "generation_basis",
    "publication_disposition",
    "qa_disposition"
  ],
  "properties": {
    "visual_id": {
      "type": "string",
      "pattern": "^VE-NOE-GER-P02P04-[0-9]{3}$"
    },
    "relative_path": {"type": "string"},
    "parent_pdf_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "pdf_page": {"type": ["integer", "string"]},
    "width_px": {"type": "integer", "minimum": 1},
    "height_px": {"type": "integer", "minimum": 1},
    "generation_dpi": {"type": ["integer", "number", "string"]},
    "embedded_dpi_x": {"type": ["number", "string"]},
    "embedded_dpi_y": {"type": ["number", "string"]},
    "rotation_degrees": {"type": "integer"},
    "bounding_box": {"type": "string"},
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "bytes": {"type": "integer", "minimum": 1},
    "linked_structural_unit": {"type": "string"},
    "generation_basis": {
      "enum": [
        "producer_final_after_render",
        "archive_contact_sheet_from_producer_final_renders"
      ]
    },
    "publication_disposition": {"const": "open_payload"},
    "qa_disposition": {
      "enum": [
        "accepted_no_visible_defect_independent_rebuild_render_byte_match",
        "accepted_navigation_only_original_detail_pages_reviewed"
      ]
    }
  },
  "additionalProperties": false
}
