{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/noether-p06-ko-difficulty-v1.json",
  "title": "Noether Paper 6 Korean append-only difficulty/failure record",
  "description": "Append-only producer history. Corrections append new records; resolved failures remain.",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "sequence",
    "observed_at",
    "time_precision",
    "work_id",
    "tranche_ids",
    "unit_ids",
    "state",
    "classification",
    "authority_context",
    "source_locators",
    "target_artifacts",
    "symptom",
    "cause_evidence",
    "attempted_approaches",
    "resolution_or_hold",
    "evidence",
    "residual_risk",
    "recurrence_cues",
    "related_structural_ids",
    "related_decision_ids",
    "transferable_lesson",
    "previous_record_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^CJK-KO-P06-HARD-[0-9]{3}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "observed_at": {
      "type": "string"
    },
    "time_precision": {
      "enum": [
        "second",
        "minute",
        "hour",
        "day"
      ]
    },
    "work_id": {
      "const": "NOE-P06"
    },
    "tranche_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "enum": [
        "resolved",
        "held",
        "active_control",
        "retry_specified"
      ]
    },
    "classification": {
      "enum": [
        "source_fact",
        "computation",
        "editorial_inference",
        "model_preference",
        "external_validation",
        "human_validation"
      ]
    },
    "authority_context": {
      "type": "object"
    },
    "source_locators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_artifacts": {
      "type": "array"
    },
    "symptom": {
      "type": "string"
    },
    "cause_evidence": {
      "type": "string"
    },
    "attempted_approaches": {
      "type": "array",
      "minItems": 1
    },
    "resolution_or_hold": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "residual_risk": {
      "type": "string"
    },
    "recurrence_cues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_structural_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transferable_lesson": {
      "type": "string"
    },
    "previous_record_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
