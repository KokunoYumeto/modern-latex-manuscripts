{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/noether-p06-ko-visual-evidence-v1.json",
  "title": "Noether Paper 6 Korean visual-evidence record",
  "description": "Schema retained for the explicit zero-record producer inventory.",
  "type": "object",
  "required": [
    "schema_version",
    "visual_id",
    "evidence_type",
    "parent_source_path",
    "parent_source_sha256",
    "page_number",
    "bounding_box",
    "width_px",
    "height_px",
    "dpi",
    "rotation_degrees",
    "image_sha256",
    "linked_structural_ids",
    "linked_tex_units",
    "qa_state",
    "review_state",
    "rights_basis",
    "publication_disposition",
    "supersedes_visual_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "visual_id": {
      "type": "string",
      "pattern": "^NOE-P06-KO-VIS-[0-9]{4}$"
    },
    "evidence_type": {
      "enum": [
        "source_page",
        "source_crop",
        "equation_crop",
        "diagram_crop",
        "target_render",
        "contact_sheet",
        "before_after",
        "segmentation_artifact",
        "model_overlay"
      ]
    },
    "parent_source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_source_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-F0-9]{64}$"
    },
    "page_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "bounding_box": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height",
        "units"
      ]
    },
    "width_px": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height_px": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "dpi": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "rotation_degrees": {
      "type": [
        "number",
        "null"
      ]
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "linked_structural_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_tex_units": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qa_state": {
      "enum": [
        "uninspected",
        "producer_inspected",
        "independently_reviewed"
      ]
    },
    "review_state": {
      "enum": [
        "unchecked",
        "checked",
        "held"
      ]
    },
    "rights_basis": {
      "type": "string"
    },
    "publication_disposition": {
      "enum": [
        "public_safe",
        "rights_blocked",
        "private_excluded",
        "pending"
      ]
    },
    "supersedes_visual_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
