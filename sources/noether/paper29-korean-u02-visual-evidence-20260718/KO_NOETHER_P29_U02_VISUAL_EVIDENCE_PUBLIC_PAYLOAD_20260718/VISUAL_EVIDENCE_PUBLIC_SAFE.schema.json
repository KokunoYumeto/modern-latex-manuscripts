{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schema/noether-paper29-ko-u02-visual-evidence-public-safe-1.0.0.json",
  "title": "Public-safe projection of Korean Noether Paper 29 U02 visual evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "visual_id", "work_id", "unit_id", "language", "evidence_role", "authority_class", "asset_name", "asset_sha256", "byte_count", "mime_type", "binary_included", "package_relative_path", "parent_sha256", "printed_page", "source_index", "edition_coordinates", "bbox", "geometry", "structural_ids", "decision_ids", "qa_disposition", "human_review", "rights_basis", "publication_disposition", "supersession_state", "supersedes", "superseded_by", "reconstruction_status", "rights_note", "continuation_cursor"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "visual_id": {"type": "string", "pattern": "^VE-NOE-P29-KO-U02-[0-9]{3}$"},
    "work_id": {"const": "noether.paper29.ko.u02"},
    "unit_id": {"const": "KO-NOE-P29-U02"},
    "language": {"enum": ["de", "ko-KR"]},
    "evidence_role": {"enum": ["source_page", "target_render", "before_after_render"]},
    "authority_class": {"enum": ["primary_scan_witness", "derived_project_render", "reconstructed_project_render"]},
    "asset_name": {"type": "string", "minLength": 1},
    "asset_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "byte_count": {"type": "integer", "minimum": 1},
    "mime_type": {"enum": ["image/jpeg", "image/png"]},
    "binary_included": {"type": "boolean"},
    "package_relative_path": {"type": ["string", "null"]},
    "parent_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "printed_page": {"type": ["string", "null"]},
    "source_index": {"type": ["string", "null"]},
    "edition_coordinates": {"type": "string", "minLength": 1},
    "bbox": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["width_px", "height_px", "dpi_x", "dpi_y", "rotation_degrees"], "properties": {"width_px": {"type": "integer", "minimum": 1}, "height_px": {"type": "integer", "minimum": 1}, "dpi_x": {"type": "number", "minimum": 1}, "dpi_y": {"type": "number", "minimum": 1}, "rotation_degrees": {"type": "number"}}},
    "structural_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "decision_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "qa_disposition": {"type": "string", "minLength": 1},
    "human_review": {"const": "not_performed"},
    "rights_basis": {"enum": ["unresolved_source_redistribution_rights", "project_generated_from_project_tex"]},
    "publication_disposition": {"enum": ["open_payload", "manifest_only_rights_blocked"]},
    "supersession_state": {"type": "string", "minLength": 1},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "superseded_by": {"type": "array", "items": {"type": "string"}},
    "reconstruction_status": {"type": ["string", "null"]},
    "rights_note": {"type": "string", "minLength": 1},
    "continuation_cursor": {"type": "string", "minLength": 1}
  }
}
