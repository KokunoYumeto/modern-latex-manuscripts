{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/noether-p29-ko-u04-visual-public-safe-1.0.0.json",
  "title": "Noether Paper 29 Korean U04 public-safe visual-evidence record",
  "description": "The canonical U04 schema plus the rule that a rights-blocked source image has no filesystem path in the public projection.",
  "allOf": [
    {"$ref": "https://interlanguage.local/schemas/noether-p29-ko-u04-visual-evidence-1.0.0.json"},
    {
      "if": {"properties": {"publication_disposition": {"const": "manifest_only_rights_blocked"}}},
      "then": {"properties": {"asset": {"properties": {"path": {"const": null}}}}}
    }
  ]
}
