{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noether Paper 8 target visual record",
  "type": "object",
  "required": [
    "visual_id",
    "relative_path",
    "parent_pdf_sha256",
    "pdf_page",
    "cumulative_output_page",
    "width_px",
    "height_px",
    "dpi",
    "rotation_degrees",
    "bounding_box",
    "sha256",
    "bytes",
    "linked_structural_unit",
    "publication_disposition",
    "qa_disposition"
  ],
  "properties": {
    "visual_id": {"type": "string", "pattern": "^VE-NOE-P08-[0-9]{3}$"},
    "relative_path": {"type": "string"},
    "parent_pdf_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "pdf_page": {"type": ["integer", "string"]},
    "cumulative_output_page": {"type": ["integer", "string"]},
    "width_px": {"type": "integer", "minimum": 1},
    "height_px": {"type": "integer", "minimum": 1},
    "dpi": {"type": ["integer", "string"]},
    "rotation_degrees": {"type": "integer"},
    "bounding_box": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 1},
    "linked_structural_unit": {"type": "string"},
    "publication_disposition": {"const": "open_payload"},
    "qa_disposition": {"type": "string"}
  },
  "additionalProperties": false
}

