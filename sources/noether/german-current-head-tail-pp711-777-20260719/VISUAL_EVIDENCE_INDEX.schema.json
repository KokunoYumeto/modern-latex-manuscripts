{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noether German pp711-777 target visual record",
  "type": "object",
  "required": [
    "visual_id",
    "relative_path",
    "parent_pdf_sha256",
    "pdf_page",
    "width_px",
    "height_px",
    "dpi_x",
    "dpi_y",
    "rotation_degrees",
    "bounding_box",
    "sha256",
    "bytes",
    "linked_structural_unit",
    "generation_basis",
    "publication_disposition",
    "qa_disposition"
  ],
  "properties": {
    "visual_id": {
      "type": "string",
      "pattern": "^VE-NOE-GER-P711777-[0-9]{3}$"
    },
    "relative_path": {"type": "string"},
    "parent_pdf_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "pdf_page": {"type": ["integer", "string"]},
    "width_px": {"type": "integer", "minimum": 1},
    "height_px": {"type": "integer", "minimum": 1},
    "dpi_x": {"type": "number", "exclusiveMinimum": 0},
    "dpi_y": {"type": "number", "exclusiveMinimum": 0},
    "rotation_degrees": {"type": "integer"},
    "bounding_box": {"type": "string"},
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "bytes": {"type": "integer", "minimum": 1},
    "linked_structural_unit": {"type": "string"},
    "generation_basis": {
      "enum": [
        "producer_final_after_render_byte_replayed",
        "archive_fresh_final_pdf_render"
      ]
    },
    "publication_disposition": {"const": "open_payload"},
    "qa_disposition": {"const": "accepted_no_visible_defect"}
  },
  "additionalProperties": false
}
