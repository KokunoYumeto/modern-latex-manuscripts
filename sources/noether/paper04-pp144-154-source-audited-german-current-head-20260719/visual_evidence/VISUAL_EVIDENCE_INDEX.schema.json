{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noether Paper 4 pp144-154 visual evidence row",
  "type": "object",
  "required": [
    "visual_id",
    "relative_path",
    "role",
    "parent_pdf_sha256",
    "bytes",
    "sha256",
    "qa_disposition",
    "publication_disposition",
    "rights_basis"
  ],
  "properties": {
    "visual_id": {
      "type": "string",
      "pattern": "^VE-NOE-P04-PP144-154-[0-9]{3}$"
    },
    "relative_path": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "parent_pdf_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "output_page": {},
    "printed_page_span": {
      "type": "string"
    },
    "linked_scope": {
      "type": "string"
    },
    "width_px": {
      "type": "integer",
      "minimum": 1
    },
    "height_px": {
      "type": "integer",
      "minimum": 1
    },
    "dpi": {},
    "rotation_degrees": {
      "type": "integer"
    },
    "bounding_box": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "qa_disposition": {
      "type": "string"
    },
    "publication_disposition": {
      "enum": [
        "open_payload",
        "manifest_only_rights_blocked",
        "metadata_only"
      ]
    },
    "rights_basis": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
