{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noether-slavic-v038-structural-index/1.0",
  "title": "Noether v038 touched-scope Slavic structural index record",
  "type": "object",
  "required": [
    "schema_version",
    "structural_id",
    "work_id",
    "work_unit_id",
    "structure_type",
    "type_ordinal",
    "language",
    "script",
    "surface_role",
    "parent_id",
    "order_index",
    "relations",
    "authority_locator",
    "target_locator",
    "completion_state",
    "review_state",
    "publication_state",
    "boundary_confidence",
    "boundary_basis",
    "continuation_cursor",
    "text_preview"
  ],
  "properties": {
    "schema_version": {"const": "noether-slavic-v038-structural-index/1.0"},
    "structural_id": {"type": "string", "pattern": "^SLISV-V038-[A-Z_]+-(PAPERS_1_43_BASE|P06|BOOK_(?:TITLE_INTRO|S[0-9]{2})|POST45|POSTBIB)-[A-Z_]+-[0-9]{4}$"},
    "work_id": {"const": "NOETHER-CUMULATIVE"},
    "work_unit_id": {"type": "string", "pattern": "^(PAPERS_1_43_BASE|P06|BOOK_TITLE_INTRO|BOOK_S[0-9]{2}|POST45|POSTBIB)$"},
    "structure_type": {"type": "string"},
    "type_ordinal": {"type": "integer", "minimum": 1},
    "language": {"enum": ["ru-Cyrl", "uk-Cyrl", "isv-Latn", "isv-Cyrl"]},
    "script": {"enum": ["Latin", "Cyrillic"]},
    "surface_role": {"enum": ["editable_model_authored_translation", "inherited_editable_translation", "deterministic_reader_projection"]},
    "parent_id": {"type": ["string", "null"]},
    "order_index": {"type": "integer", "minimum": 0},
    "relations": {
      "type": "object",
      "required": ["pair_group", "paired_surface_ids", "labels", "references", "dependencies"],
      "properties": {
        "pair_group": {"type": "string"},
        "paired_surface_ids": {"type": "array", "items": {"type": "string"}},
        "labels": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authority_locator": {"$ref": "#/$defs/authority_locator"},
    "target_locator": {"$ref": "#/$defs/target_locator"},
    "completion_state": {"const": "release_source_present"},
    "review_state": {"const": "machine_formula_and_structure_checked_no_native_review"},
    "publication_state": {"const": "candidate_for_owner_handoff"},
    "boundary_confidence": {"enum": ["high", "medium", "low"]},
    "boundary_basis": {"type": "string"},
    "continuation_cursor": {"type": ["string", "null"]},
    "text_preview": {"type": "string", "maxLength": 240}
  },
  "$defs": {
    "authority_locator": {
      "type": "object",
      "required": ["path", "start_line", "end_line", "file_sha256", "unit_sha256", "mapping_precision"],
      "properties": {
        "path": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "file_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "unit_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "mapping_precision": {"const": "work_unit"}
      },
      "additionalProperties": false
    },
    "target_locator": {
      "type": "object",
      "required": ["path", "start_line", "end_line", "file_sha256", "span_sha256"],
      "properties": {
        "path": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "file_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "span_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
