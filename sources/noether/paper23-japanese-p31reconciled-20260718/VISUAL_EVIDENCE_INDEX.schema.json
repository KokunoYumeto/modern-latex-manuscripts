{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schema/noether-p23-ja-visual-evidence-1.0.0.json",
  "title": "Interlanguage Japanese Noether Paper 23 visual-evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "visual_id",
    "project",
    "lane",
    "work_id",
    "unit_id",
    "language",
    "structural_ids",
    "decision_ids",
    "evidence_role",
    "authority_class",
    "asset",
    "source_coordinates",
    "geometry",
    "linked_artifacts",
    "extraction_or_model_outputs",
    "rejected_readings",
    "review",
    "rights",
    "publication_disposition",
    "continuation_cursor",
    "supersession_relation",
    "supersedes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "visual_id": {
      "type": "string",
      "pattern": "^VE-NOE-P23-JA-[0-9]{3}$"
    },
    "project": {
      "const": "interlanguage"
    },
    "lane": {
      "const": "CJK-Japanese"
    },
    "work_id": {
      "const": "noether.paper23.ja"
    },
    "unit_id": {
      "const": "NOE-P23-JA-U000"
    },
    "language": {
      "const": "ja-JP"
    },
    "structural_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^NOE-P23-JA-"
      },
      "uniqueItems": true
    },
    "decision_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_role": {
      "const": "target_render"
    },
    "authority_class": {
      "const": "derived_target_output"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "sha256",
        "byte_count",
        "mime_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^render_check/"
        },
        "name": {
          "type": "string",
          "pattern": "^Noether_Paper23_Japanese_SourceReconciled_v001-[0-9]{2}\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "mime_type": {
          "const": "image/png"
        }
      }
    },
    "source_coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "source_url_or_public_identifier",
        "parent_asset_name",
        "parent_asset_path",
        "parent_sha256",
        "physical_page",
        "printed_page",
        "source_index",
        "edition_coordinates",
        "bbox",
        "parent_dimensions"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "source_url_or_public_identifier": {
          "type": "string",
          "minLength": 1
        },
        "parent_asset_name": {
          "const": "Noether_Paper23_Japanese_SourceReconciled_v001.pdf"
        },
        "parent_asset_path": {
          "const": "output/pdf/Noether_Paper23_Japanese_SourceReconciled_v001.pdf"
        },
        "parent_sha256": {
          "const": "2D39C6B9D9E81CC38E29A6FB9A354EC489BF13455CC5D96AAF67CAB9FCCEB748"
        },
        "physical_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "printed_page": {
          "type": "string",
          "pattern": "^[1-4]$"
        },
        "source_index": {
          "type": "string",
          "pattern": "^target_pdf_page_[0-9]{3}$"
        },
        "edition_coordinates": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinate_system",
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "coordinate_system": {
              "const": "pixels_top_left"
            },
            "x": {
              "const": 0
            },
            "y": {
              "const": 0
            },
            "width": {
              "const": 1654
            },
            "height": {
              "const": 2339
            }
          }
        },
        "parent_dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "unit"
          ],
          "properties": {
            "width": {
              "const": 595.28
            },
            "height": {
              "const": 841.89
            },
            "unit": {
              "const": "pdf_points"
            }
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_px",
        "height_px",
        "dpi_x",
        "dpi_y",
        "dpi_basis",
        "rotation_degrees",
        "rotation_basis"
      ],
      "properties": {
        "width_px": {
          "const": 1654
        },
        "height_px": {
          "const": 2339
        },
        "dpi_x": {
          "const": 200
        },
        "dpi_y": {
          "const": 200
        },
        "dpi_basis": {
          "const": "embedded_png_pHYs_and_accepted_200_ppi_render_record"
        },
        "rotation_degrees": {
          "const": 0
        },
        "rotation_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "linked_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_authority_tex_path",
        "source_authority_tex_sha256",
        "source_authority_locator",
        "source_authority_span_sha256",
        "target_tex_path",
        "target_tex_sha256",
        "target_pdf_path",
        "target_pdf_sha256",
        "target_pdf_page",
        "extracted_text_path",
        "extracted_text_sha256",
        "cross_reference_visual_ids"
      ],
      "properties": {
        "source_authority_tex_path": {
          "type": "string",
          "minLength": 1
        },
        "source_authority_tex_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "source_authority_locator": {
          "const": "DE 13507-13630"
        },
        "source_authority_span_sha256": {
          "const": "7A9E4C9910FBEFECA45A652BDF99A58F9C0BD4089D1F9630D96D776739B0BCE5"
        },
        "target_tex_path": {
          "const": "Noether_Paper23_Japanese_SourceReconciled_v001.tex"
        },
        "target_tex_sha256": {
          "const": "758D36CA12EA463AD4DC23A04536E801FB9A6B190F8E79E87C668EDC15FEC6D9"
        },
        "target_pdf_path": {
          "const": "output/pdf/Noether_Paper23_Japanese_SourceReconciled_v001.pdf"
        },
        "target_pdf_sha256": {
          "const": "2D39C6B9D9E81CC38E29A6FB9A354EC489BF13455CC5D96AAF67CAB9FCCEB748"
        },
        "target_pdf_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "extracted_text_path": {
          "const": "output/pdf/Noether_Paper23_Japanese_SourceReconciled_v001.txt"
        },
        "extracted_text_sha256": {
          "const": "974C77BB552A106BDB8AF97C09B13D11189D7FE9CAB7E5A144AC13B0B332444B"
        },
        "cross_reference_visual_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^VE-NOE-P23-JA-[0-9]{3}$"
          },
          "uniqueItems": true
        }
      }
    },
    "extraction_or_model_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_readings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "human_review",
        "qa_disposition",
        "residual_uncertainty"
      ],
      "properties": {
        "state": {
          "const": "internally_visual_checked_original_detail"
        },
        "human_review": {
          "const": "not_performed"
        },
        "qa_disposition": {
          "const": "accepted_no_visible_defect"
        },
        "residual_uncertainty": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "status_note"
      ],
      "properties": {
        "basis": {
          "const": "project_generated_from_project_tex"
        },
        "status_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publication_disposition": {
      "const": "open_payload"
    },
    "continuation_cursor": {
      "type": "string",
      "minLength": 1
    },
    "supersession_relation": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
