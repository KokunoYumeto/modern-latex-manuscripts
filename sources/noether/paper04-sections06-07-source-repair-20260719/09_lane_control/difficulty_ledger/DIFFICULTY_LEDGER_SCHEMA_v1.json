{
  "$schema": "httpprivate-source/schema",
  "$id": "slavic-interslavic-difficulty-ledger-v1",
  "title": "Slavic/Interslavic append-only difficulty and failure record",
  "type": "object",
  "required": [
    "schema_version",
    "issue_id",
    "recorded_at",
    "time_precision",
    "work_unit",
    "locators",
    "difficulty_class",
    "symptom",
    "severity",
    "discovery_channel",
    "cause",
    "attempts",
    "evidence",
    "state",
    "resolution_or_workaround",
    "residual_risk",
    "recurrence_cues",
    "transferable_lesson",
    "future_check",
    "related_decision_ids",
    "related_structural_ids",
    "changed_artifacts",
    "supersession_state"
  ],
  "properties": {
    "schema_version": {
      "const": "slavic-interslavic-difficulty-ledger-v1"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^SLISV-DIFF-[0-9]{4}$"
    },
    "recorded_at": {
      "type": "string"
    },
    "time_precision": {
      "type": "string"
    },
    "work_unit": {
      "type": "string"
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "difficulty_class": {
      "type": "string"
    },
    "symptom": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "discovery_channel": {
      "type": "string"
    },
    "cause": {
      "type": "object",
      "required": [
        "evidence",
        "inference"
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "state": {
      "enum": [
        "resolved",
        "mitigated",
        "held_external",
        "open"
      ]
    },
    "resolution_or_workaround": {
      "type": "string"
    },
    "residual_risk": {
      "type": "string"
    },
    "recurrence_cues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transferable_lesson": {
      "type": "string"
    },
    "future_check": {
      "type": "string"
    },
    "related_decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_structural_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersession_state": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
