{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schema/visual-evidence-public-safe-1.0.0.json",
  "title": "Public-safe visual-evidence projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "visual_id", "work_id", "language", "evidence_role", "asset_name", "asset_sha256", "byte_count", "mime_type", "binary_included", "package_relative_path", "parent_sha256", "printed_page", "source_index", "bbox", "geometry", "structural_ids", "decision_ids", "qa_disposition", "human_review", "rights_basis", "publication_disposition", "rights_note", "continuation_cursor"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "visual_id": {"type": "string", "pattern": "^VE-NOE-P27-KO-[0-9]{3}$"},
    "work_id": {"const": "noether.paper27.ko"}, "language": {"enum": ["de", "ko-KR"]},
    "evidence_role": {"enum": ["source_page", "target_render"]}, "asset_name": {"type": "string"},
    "asset_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "byte_count": {"type": "integer", "minimum": 1},
    "mime_type": {"enum": ["image/jpeg", "image/png"]}, "binary_included": {"type": "boolean"},
    "package_relative_path": {"type": ["string", "null"]}, "parent_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "printed_page": {"type": ["string", "null"]}, "source_index": {"type": ["string", "null"]},
    "bbox": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}, "width": {"type": "integer"}, "height": {"type": "integer"}}, "additionalProperties": false},
    "geometry": {"type": "object", "required": ["width_px", "height_px", "dpi_x", "dpi_y", "rotation_degrees"], "properties": {"width_px": {"type": "integer"}, "height_px": {"type": "integer"}, "dpi_x": {"type": "number"}, "dpi_y": {"type": "number"}, "rotation_degrees": {"type": "number"}}, "additionalProperties": false},
    "structural_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "decision_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "qa_disposition": {"type": "string"}, "human_review": {"const": "not_performed"},
    "rights_basis": {"enum": ["unresolved_source_redistribution_rights", "project_generated_from_project_tex"]},
    "publication_disposition": {"enum": ["open_payload", "manifest_only_rights_blocked"]},
    "rights_note": {"type": "string"}, "continuation_cursor": {"type": "string"}
  }
}
