{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Korean Noether structural JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "parent_id",
    "order",
    "authority",
    "target",
    "relations",
    "language",
    "state",
    "continuation",
    "evidence_sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CJK-KO-P09-STR-[0-9]{4}$"
    },
    "type": {
      "type": "string"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "type": "object"
    },
    "target": {
      "type": [
        "object",
        "null"
      ]
    },
    "relations": {
      "type": "array"
    },
    "language": {
      "const": "ko"
    },
    "state": {
      "type": "object"
    },
    "continuation": {
      "type": "object"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    }
  }
}
