{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/noether-p29-ko-u03-difficulty-ledger-1.0.0.json",
  "title": "Append-only Korean Noether P29 U03 difficulty record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "difficulty_id", "recorded_at", "time_precision",
    "work_unit", "authority", "source_locator", "target_locator", "symptom",
    "cause_evidence", "attempted_approaches", "rejected_approaches", "state",
    "resolution_or_hold", "evidence_hashes_and_tests", "residual_risk",
    "recurrence_cues", "related_decision_ids", "related_structural_ids",
    "transferable_lesson", "revisit_condition", "previous_hash", "record_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "difficulty_id": {"type": "string", "pattern": "^CJK-KO-P29-U03-HARD-[0-9]{3}$"},
    "recorded_at": {"type": "string"},
    "time_precision": {"type": "string"},
    "work_unit": {"const": "P29-KO-U03"},
    "authority": {"type": "string"},
    "source_locator": {"type": "string"},
    "target_locator": {"type": "string"},
    "symptom": {"type": "string"},
    "cause_evidence": {"type": "string"},
    "attempted_approaches": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rejected_approaches": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "state": {"enum": ["resolved", "held", "workaround"]},
    "resolution_or_hold": {"type": "string"},
    "evidence_hashes_and_tests": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "residual_risk": {"type": "string"},
    "recurrence_cues": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "related_decision_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "related_structural_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "transferable_lesson": {"type": "string"},
    "revisit_condition": {"type": "string"},
    "previous_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
