{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/noether/schemas/fail-detail-v1.json",
  "title": "Noether canon-control detailed failure record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "issue_id",
    "affected_unit",
    "locator",
    "symptom",
    "error_class",
    "severity",
    "attempted_approaches",
    "rejected_approaches",
    "evidence",
    "resolution_or_held_state",
    "residual_risk",
    "recurrence_cues",
    "lesson",
    "status",
    "legacy_record"
  ],
  "properties": {
    "schema": {"const": "noeth.fail-detail.v1"},
    "record_id": {"type": "string", "pattern": "^NOETH-FAILDET-[0-9]{3}$"},
    "issue_id": {"type": "string", "pattern": "^NOETH-FAIL-[0-9]{3}$"},
    "affected_unit": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "symptom": {"type": "string", "minLength": 1},
    "error_class": {"type": "string", "minLength": 1},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "attempted_approaches": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rejected_approaches": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resolution_or_held_state": {"type": "string", "minLength": 1},
    "residual_risk": {"type": "string", "minLength": 1},
    "recurrence_cues": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "lesson": {"type": "string", "minLength": 1},
    "status": {"enum": ["controlled", "closed", "held", "open_external"]},
    "legacy_record": {"type": "string", "pattern": "^ledgers/FAILURE_AUDIT.jsonl#NOETH-FAIL-[0-9]{3}$"}
  }
}
