{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/noether/schemas/struct-v1.json",
  "title": "Noether canon-control detailed structural record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "object_type",
    "parent_unit_id",
    "parent_binder_id",
    "order",
    "label",
    "authority",
    "source_ref",
    "source_coordinates",
    "retained_artifact",
    "dependencies",
    "cross_references",
    "cross_reference_state",
    "review_state",
    "uncertainty",
    "target_locator_state",
    "indexing_limit"
  ],
  "properties": {
    "schema": {"const": "noeth.struct.v1"},
    "record_id": {"type": "string", "pattern": "^NOETH-STR-[0-9]{3}$"},
    "object_type": {"enum": ["source_unit", "tranche", "editorial_locus", "bibliography_locus"]},
    "parent_unit_id": {"type": "string", "pattern": "^NOETH-P[0-9]{2}$"},
    "parent_binder_id": {"type": ["string", "null"]},
    "order": {"type": "integer", "minimum": 1},
    "label": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "raw_sha256", "pointer_id", "pointer_sha256"],
      "properties": {
        "authority_id": {"const": "NOETH-DE-ED-0002"},
        "raw_sha256": {"const": "C9A125167ACB33D914EE4374B65AE7CDF0052F568371B8B77B720EA178ABF0E3"},
        "pointer_id": {"const": "NOETH-DE-AUTH-v009-20260804"},
        "pointer_sha256": {"const": "B06BE3530D9CF2E82B56FDBA7FE41D5D044DF2425DFA2A059D4939EAA2F7A6C2"}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "locator", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "source_coordinates": {"type": "object", "minProperties": 1},
    "retained_artifact": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "bytes", "sha256", "eol_profile"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "eol_profile": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "cross_references": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "cross_reference_state": {"type": "string", "minLength": 1},
    "review_state": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "target_locator_state": {"const": "lane_owned_not_collected_by_german_source_owner"},
    "indexing_limit": {"type": "string", "minLength": 1}
  }
}
