{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interlanguage:cjk:ko:p08:structure:v1",
  "title": "Korean Noether P08 structural index record",
  "type": "object",
  "required": ["id", "type", "parent_id", "order", "authority", "target", "relations", "language", "state", "continuation", "evidence_sha256"],
  "properties": {
    "id": {"type": "string", "pattern": "^CJK-KO-P08-STR-[0-9]{4}$"},
    "type": {"type": "string"},
    "parent_id": {"type": ["string", "null"]},
    "order": {"type": "integer", "minimum": 1},
    "authority": {
      "type": "object",
      "required": ["edition_id", "whole_path", "whole_sha256", "snapshot_path", "line_start", "line_end", "bytes", "sha256"]
    },
    "target": {"type": ["object", "null"]},
    "relations": {"type": "array"},
    "language": {"const": "ko"},
    "state": {
      "type": "object",
      "required": ["translation", "review", "build", "render", "publication"]
    },
    "continuation": {"type": "object", "required": ["next_authority_line"]},
    "evidence_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  },
  "additionalProperties": false
}
