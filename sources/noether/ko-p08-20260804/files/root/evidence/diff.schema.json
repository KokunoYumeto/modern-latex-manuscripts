{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interlanguage:cjk:ko:p08:difficulty:v1",
  "title": "Append-only Korean Noether P08 difficulty/failure record",
  "type": "object",
  "required": ["id", "recorded_at", "precision", "structural_ids", "authority", "target", "symptom", "cause_evidence", "attempts", "resolution", "state", "tests", "residual_risk", "recurrence_cues", "decision_ids", "transferable_lesson", "claim_types"],
  "properties": {
    "id": {"type": "string", "pattern": "^CJK-KO-P08-HARD-[0-9]{3}$"},
    "recorded_at": {"type": "string"},
    "precision": {"type": "string"},
    "structural_ids": {"type": "array"},
    "authority": {"type": "object"},
    "target": {"type": "object"},
    "symptom": {"type": "string"},
    "cause_evidence": {"type": "string"},
    "attempts": {"type": "array"},
    "resolution": {"type": "string"},
    "state": {"enum": ["provisional_resolved", "held", "unresolved"]},
    "tests": {"type": "array"},
    "residual_risk": {"type": "string"},
    "recurrence_cues": {"type": "array"},
    "decision_ids": {"type": "array"},
    "transferable_lesson": {"type": "string"},
    "claim_types": {"type": "object"},
    "supersedes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
