{
  "$schema": "httpprivate-source/schema",
  "$id": "httpprivate-source/noether-p29-ko-u04-difficulty-ledger-1.0.0.json",
  "title": "Korean Noether Paper 29 U04 difficulty record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "difficulty_id",
    "recorded_at",
    "time_precision",
    "work_unit",
    "authority",
    "source_locator",
    "target_locator",
    "symptom",
    "cause_evidence",
    "attempted_approaches",
    "rejected_approaches",
    "state",
    "resolution_or_hold",
    "evidence_hashes_and_tests",
    "evidence_classification",
    "residual_risk",
    "recurrence_cues",
    "related_decision_ids",
    "related_structural_ids",
    "transferable_lesson",
    "revisit_condition",
    "previous_hash",
    "record_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "difficulty_id": {
      "type": "string",
      "pattern": "^CJK-KO-P29-U04-HARD-[0-9]{3}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "time_precision": {
      "type": "string",
      "minLength": 1
    },
    "work_unit": {
      "const": "P29-KO-U04"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "target_locator": {
      "type": "string",
      "minLength": 1
    },
    "symptom": {
      "type": "string",
      "minLength": 1
    },
    "cause_evidence": {
      "type": "string",
      "minLength": 1
    },
    "attempted_approaches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rejected_approaches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "state": {
      "enum": [
        "resolved",
        "held",
        "workaround"
      ]
    },
    "resolution_or_hold": {
      "type": "string",
      "minLength": 1
    },
    "evidence_hashes_and_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fact",
        "computation",
        "editorial_inference",
        "model_preference",
        "external_or_human_validation"
      ],
      "properties": {
        "source_fact": {
          "type": "string",
          "minLength": 1
        },
        "computation": {
          "type": "string",
          "minLength": 1
        },
        "editorial_inference": {
          "type": "string",
          "minLength": 1
        },
        "model_preference": {
          "type": "string",
          "minLength": 1
        },
        "external_or_human_validation": {
          "const": "absent_do_not_claim"
        }
      }
    },
    "residual_risk": {
      "type": "string",
      "minLength": 1
    },
    "recurrence_cues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "related_decision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CJK-KO-P29-[0-9]{3}$"
      },
      "minItems": 1
    },
    "related_structural_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^NOE-P29-KO-U04-[A-Z]+-[0-9]{3}$"
      },
      "minItems": 1
    },
    "transferable_lesson": {
      "type": "string",
      "minLength": 1
    },
    "revisit_condition": {
      "type": "string",
      "minLength": 1
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    }
  }
}
