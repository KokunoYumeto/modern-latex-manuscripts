{
  "$schema": "httpprivate-source/schema",
  "$id": "httpprivate-source/noether-p29-ko-u04-visual-evidence-1.0.0.json",
  "title": "Noether Paper 29 Korean U04 visual-evidence record",
  "description": "Canonical record for each source page or project-generated render used in U04. Source paths are allowed only in the private canonical index; the public-safe projection nulls them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "visual_id",
    "work_id",
    "unit_id",
    "language",
    "structural_ids",
    "decision_ids",
    "evidence_role",
    "authority_class",
    "asset",
    "source_coordinates",
    "geometry",
    "linked_artifacts",
    "review",
    "rights",
    "publication_disposition",
    "supersession",
    "continuation_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "visual_id": {
      "type": "string",
      "pattern": "^VE-NOE-P29-KO-U04-[0-9]{3}$"
    },
    "work_id": {
      "const": "noether.paper29.ko.u04"
    },
    "unit_id": {
      "const": "P29-KO-U04"
    },
    "language": {
      "enum": [
        "de",
        "ko-KR"
      ]
    },
    "structural_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^NOE-P29-KO-U04-(ROOT|PROOF|PARA|STEP|DISPLAY|NOTE)-[0-9]{3}$"
      }
    },
    "decision_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidence_role": {
      "enum": [
        "source_page",
        "target_render",
        "before_after_render"
      ]
    },
    "authority_class": {
      "type": "string",
      "minLength": 1
    },
    "asset": {
      "$ref": "#/$defs/asset"
    },
    "source_coordinates": {
      "$ref": "#/$defs/source_coordinates"
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    },
    "linked_artifacts": {
      "type": "object",
      "minProperties": 1
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "publication_disposition": {
      "enum": [
        "manifest_only_rights_blocked",
        "open_payload"
      ]
    },
    "supersession": {
      "$ref": "#/$defs/supersession"
    },
    "continuation_cursor": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "sha256",
        "byte_count",
        "mime_type"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "mime_type": {
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "coordinate_system",
        "x",
        "y",
        "width",
        "height",
        "region_role",
        "basis"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_system": {
          "const": "pixels_top_left"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "region_role": {
          "enum": [
            "u04_main_text",
            "u04_note_1",
            "full_render_page"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "parent_asset_name",
        "parent_sha256",
        "physical_page",
        "printed_page",
        "source_index",
        "edition_coordinates",
        "bboxes"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "parent_asset_name": {
          "type": "string",
          "minLength": 1
        },
        "parent_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "physical_page": {
          "type": "integer",
          "minimum": 1
        },
        "printed_page": {
          "type": "string",
          "minLength": 1
        },
        "source_index": {
          "type": [
            "string",
            "null"
          ]
        },
        "edition_coordinates": {
          "type": "string",
          "minLength": 1
        },
        "bboxes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bbox"
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_px",
        "height_px",
        "dpi_x",
        "dpi_y",
        "dpi_basis",
        "rotation_degrees",
        "rotation_basis"
      ],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "dpi_x": {
          "type": "integer",
          "minimum": 1
        },
        "dpi_y": {
          "type": "integer",
          "minimum": 1
        },
        "dpi_basis": {
          "type": "string",
          "minLength": 1
        },
        "rotation_degrees": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "rotation_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "review_basis",
        "human_review",
        "qa_disposition",
        "residual_uncertainty"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "review_basis": {
          "type": "string",
          "minLength": 1
        },
        "human_review": {
          "const": "absent_do_not_claim"
        },
        "qa_disposition": {
          "type": "string",
          "minLength": 1
        },
        "residual_uncertainty": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "status_note"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "status_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "supersedes",
        "superseded_by",
        "issue"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issue": {
          "type": "string"
        }
      }
    }
  }
}
