    {
      "node_id": "KO-P29-U04-A001",
      "node_type": "adverse_evidence",
      "label": "Koeffizientenbereich can attract the prior generic 계수 영역 rendering even though P is a field here."
    },
    {
      "node_id": "KO-P29-U04-A002",
      "node_type": "adverse_evidence",
      "label": "The lane's frequent endlich=finite-generation correction can contaminate unendlich viele Elemente, which is literal cardinality here."
    },
    {
      "node_id": "KO-P29-U04-A003",
      "node_type": "adverse_evidence",
      "label": "기약계 can be misread as a system of irreducible polynomials instead of Steinitz's algebraically independent function system."
    },
    {
      "node_id": "KO-P29-U04-A004",
      "node_type": "adverse_evidence",
      "label": "정수성 기저 can be mistaken for a number-field integral basis or a linearly independent basis."
    },
    {
      "node_id": "KO-P29-U04-A005",
      "node_type": "adverse_evidence",
      "label": "algebraisch ganz/ganze Abhängigkeit can collapse into ordinary algebraic dependence or integer-valuedness."
    },
    {
      "node_id": "KO-P29-U04-A006",
      "node_type": "adverse_evidence",
      "label": "부정원 can be mistaken for an unknown to solve for or an already specialized scalar parameter."
    },
    {
      "node_id": "KO-P29-U04-A007",
      "node_type": "adverse_evidence",
      "label": "특수화 can suggest arbitrary substitution and omit preservation of integral dependence."
    },
    {
      "node_id": "KO-P29-U04-A008",
      "node_type": "adverse_evidence",
      "label": "The U02 transitivity wording concerned algebraic dependence, while U04 requires transitivity of integrality."
    },
    {
      "node_id": "KO-P29-U04-A009",
      "node_type": "adverse_evidence",
      "label": "Quotientenkörper can attract 몫체/상체 or a residue-field sense."
    },
    {
      "node_id": "KO-P29-U04-A010",
      "node_type": "adverse_evidence",
      "label": "endlicher Erweiterungskörper can be read as a finite-cardinality field."
    },
    {
      "node_id": "KO-P29-U04-A011",
      "node_type": "adverse_evidence",
      "label": "P[g_1,...,g_t] and P(g_1,...,g_t) can be typographically or conceptually collapsed."
    },
    {
      "node_id": "KO-P29-U04-A012",
      "node_type": "adverse_evidence",
      "label": "Suppressing R/T in R-ganz/T-ganz changes the comparison and can falsely imply R=T rather than equality of two integral-element rings."
    },
    {
      "node_id": "KO-P29-U04-A013",
