{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/noether-p42-ko-difficulty-ledger.schema.json",
  "title": "Noether Paper 42 Korean append-only difficulty record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "difficulty_id",
    "recorded_at",
    "time_precision",
    "work_unit",
    "authority",
    "exact_locators",
    "symptom",
    "claim_types",
    "cause_evidence",
    "attempted_approaches",
    "state",
    "resolution_or_hold",
    "evidence_artifacts",
    "residual_risk",
    "recurrence_cues",
    "related_decision_ids",
    "related_structural_ids",
    "transferable_lesson",
    "review_state"
  ],
  "properties": {
    "difficulty_id": { "type": "string", "pattern": "^CJK-KO-P42-HARD-[0-9]{3}$" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "time_precision": { "type": "string", "minLength": 1 },
    "work_unit": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "required": ["snapshot_sha256", "historical_whole_sha256", "pointer_state"],
      "properties": {
        "snapshot_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "historical_whole_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "pointer_state": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exact_locators": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "symptom": { "type": "string", "minLength": 1 },
    "claim_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["source_fact", "computation", "editorial_inference", "model_preference", "external_or_human_validation_absent"] }
    },
    "cause_evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "attempted_approaches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["approach", "outcome", "disposition"],
        "properties": {
          "approach": { "type": "string" },
          "outcome": { "type": "string" },
          "disposition": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "state": { "enum": ["resolved", "held", "active_control"] },
    "resolution_or_hold": { "type": "string", "minLength": 1 },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256_or_status", "evidence_scope"],
        "properties": {
          "path": { "type": "string" },
          "sha256_or_status": { "type": "string" },
          "evidence_scope": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "residual_risk": { "type": "string", "minLength": 1 },
    "recurrence_cues": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "related_decision_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "related_structural_ids": { "type": "array", "items": { "type": "string" } },
    "transferable_lesson": { "type": "string", "minLength": 1 },
    "review_state": { "type": "string", "const": "producer_record_unreviewed" }
  }
}
