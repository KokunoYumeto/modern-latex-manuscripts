{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/noether-p05-ko-difficulty-ledger-v1.json",
  "title": "Noether Paper 5 Korean append-only difficulty record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "sequence",
    "observed_at",
    "time_precision",
    "work_id",
    "unit_ids",
    "authority_context",
    "source_locators",
    "target_artifacts",
    "state",
    "symptom",
    "cause_evidence",
    "attempts",
    "resolution_or_hold",
    "evidence",
    "residual_risk",
    "recurrence_cues",
    "related_structural_ids",
    "related_decision_ids",
    "transferable_lesson",
    "classification",
    "previous_record_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "pattern": "^CJK-KO-P05-HARD-[0-9]{3}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "observed_at": {"type": ["string", "null"]},
    "time_precision": {"enum": ["day", "sequence_only", "unknown"]},
    "work_id": {"const": "NOE-P05"},
    "unit_ids": {"type": "array", "items": {"type": "string", "pattern": "^U0[1-4]$"}},
    "authority_context": {
      "type": "object",
      "required": ["pointer_id", "pointer_sha256", "authority_path", "authority_sha256"],
      "properties": {
        "pointer_id": {"type": "string"},
        "pointer_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "authority_path": {"type": "string"},
        "authority_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "source_locators": {"type": "array", "items": {"type": "string"}},
    "target_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "state": {"enum": ["resolved", "held", "active_control"]},
    "symptom": {"type": "string", "minLength": 1},
    "cause_evidence": {"type": "string", "minLength": 1},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["approach", "outcome", "rejection_reason"],
        "properties": {
          "approach": {"type": "string"},
          "outcome": {"type": "string"},
          "rejection_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "resolution_or_hold": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256", "result"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"},
          "result": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "residual_risk": {"type": "string"},
    "recurrence_cues": {"type": "array", "items": {"type": "string"}},
    "related_structural_ids": {"type": "array", "items": {"type": "string", "pattern": "^NOE-P05-KO-[A-Z0-9-]+$"}},
    "related_decision_ids": {"type": "array", "items": {"type": "string"}},
    "transferable_lesson": {"type": "string", "minLength": 1},
    "classification": {
      "enum": [
        "source_fact",
        "computation",
        "editorial_inference",
        "model_preference",
        "external_or_human_validation"
      ]
    },
    "previous_record_sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"},
    "record_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  },
  "additionalProperties": false
}
