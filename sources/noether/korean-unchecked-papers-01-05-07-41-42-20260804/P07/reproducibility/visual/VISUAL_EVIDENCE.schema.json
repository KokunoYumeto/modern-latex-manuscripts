{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interlanguage:noether:p07:ko:visual-evidence:v1",
  "title": "Noether Paper 7 Korean visual evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visual_id",
    "kind",
    "path",
    "image_sha256",
    "parent_scan",
    "bounding_box",
    "dimensions",
    "linked_structural_ids",
    "linked_tex_units",
    "language",
    "qa_status",
    "review_status",
    "rights_basis",
    "publication_disposition",
    "supersession_state",
    "continuation_cursor"
  ],
  "properties": {
    "visual_id": { "type": "string", "pattern": "^NOE-P07-KO-VIS-[0-9]{3}$" },
    "kind": {
      "enum": [
        "equation_crop",
        "source_crop",
        "diagram_crop",
        "page_image",
        "target_render",
        "contact_sheet",
        "before_after",
        "segmentation_artifact",
        "model_overlay"
      ]
    },
    "path": { "type": "string", "minLength": 1 },
    "image_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "parent_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "page", "page_coordinates"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"] },
        "page_coordinates": { "type": ["string", "null"] }
      }
    },
    "bounding_box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "units"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "units": { "enum": ["pixels", "points", "normalized"] }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "dpi", "rotation_degrees"],
      "properties": {
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "dpi": { "type": ["number", "null"] },
        "rotation_degrees": { "type": "number" }
      }
    },
    "linked_structural_ids": { "type": "array", "items": { "type": "string" } },
    "linked_tex_units": { "type": "array", "items": { "type": "string" } },
    "language": { "const": "ko" },
    "qa_status": { "enum": ["uninspected", "producer_inventory_only", "qa_pass", "qa_fail"] },
    "review_status": { "enum": ["unchecked", "reviewed"] },
    "rights_basis": { "enum": ["project_generated", "public_domain", "licensed", "fair_use_research", "unresolved"] },
    "publication_disposition": { "enum": ["public_safe", "rights_blocked", "private_only", "excluded", "pending"] },
    "supersession_state": { "type": "string" },
    "continuation_cursor": { "type": "string" }
  }
}
