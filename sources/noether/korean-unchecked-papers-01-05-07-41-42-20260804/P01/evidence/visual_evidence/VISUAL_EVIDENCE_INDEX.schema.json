{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/noether-p01-ko-visual-evidence-v1.json",
  "title": "Noether Paper 1 Korean visual-evidence record",
  "type": "object",
  "required": [
    "schema_version", "evidence_id", "work_id", "language", "evidence_type",
    "parent_scan_path", "parent_scan_sha256", "page_number", "coordinate_system",
    "bounding_box", "width_px", "height_px", "dpi", "rotation_degrees",
    "image_path", "image_sha256", "linked_structural_ids", "linked_tex_units",
    "qa_status", "review_status", "rights_basis", "publication_disposition",
    "continuation_cursor", "supersedes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "pattern": "^CJK-KO-P01-VIS-[0-9]{3}$"},
    "work_id": {"const": "NOE-P01"},
    "language": {"const": "ko-KR"},
    "evidence_type": {"enum": ["source_page", "equation_crop", "diagram_crop", "target_render", "contact_sheet", "before_after", "segmentation_artifact", "model_overlay", "other"]},
    "parent_scan_path": {"type": ["string", "null"]},
    "parent_scan_sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"},
    "page_number": {"type": ["integer", "null"], "minimum": 1},
    "coordinate_system": {"type": ["string", "null"]},
    "bounding_box": {"type": ["object", "null"]},
    "width_px": {"type": ["integer", "null"], "minimum": 1},
    "height_px": {"type": ["integer", "null"], "minimum": 1},
    "dpi": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "rotation_degrees": {"type": ["number", "null"]},
    "image_path": {"type": "string", "minLength": 1},
    "image_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "linked_structural_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "linked_tex_units": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "qa_status": {"type": "string", "minLength": 1},
    "review_status": {"type": "string", "minLength": 1},
    "rights_basis": {"type": "string", "minLength": 1},
    "publication_disposition": {"enum": ["include_public", "metadata_only_rights_blocked", "exclude_private", "hold"]},
    "continuation_cursor": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
