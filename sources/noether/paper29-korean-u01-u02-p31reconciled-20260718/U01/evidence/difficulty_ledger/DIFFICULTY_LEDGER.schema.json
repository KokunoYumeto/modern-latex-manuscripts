{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.interlanguage.invalid/schemas/noether-paper29-korean-u01-difficulty-ledger-1.0.0.json",
  "title": "Noether Paper 29 Korean U01 append-only difficulty and failure record",
  "description": "One canonical JSONL record for each hard unit, failed/rejected approach, repaired defect, workaround, or unresolved blocker. Records form an append-only SHA-256 chain. Corrections must append a new stable issue ID and cite supersedes; existing lines must not be silently rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_sequence",
    "issue_id",
    "record_sha256",
    "previous_record_sha256",
    "recorded_at",
    "occurrence_time",
    "work_unit",
    "authority_cursor",
    "structural_ids",
    "source_locator",
    "target_locator",
    "difficulty_class",
    "symptom",
    "severity",
    "discovery_channel",
    "cause",
    "attempted_approaches",
    "resolution_state",
    "resolution_or_workaround",
    "evidence_artifacts",
    "residual_risk",
    "recurrence_cues",
    "transferable_lesson",
    "future_check",
    "related_decision_ids",
    "changed_artifacts",
    "supersedes",
    "supersession_state",
    "validation_state",
    "continuation_or_revisit"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ledger_sequence": {"type": "integer", "minimum": 1},
    "issue_id": {"type": "string", "pattern": "^CJK-KO-P29-HARD-[0-9]{3}$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "previous_record_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9A-F]{64}$"}
      ]
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "occurrence_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "precision"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "precision": {"enum": ["exact", "minute", "date_only", "bounded_unknown"]}
      }
    },
    "work_unit": {"type": "string", "minLength": 1},
    "authority_cursor": {"type": "string", "minLength": 1},
    "structural_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "source_locator": {"type": "string", "minLength": 1},
    "target_locator": {"type": "string", "minLength": 1},
    "difficulty_class": {"type": "string", "minLength": 1},
    "symptom": {"type": "string", "minLength": 1},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "discovery_channel": {"type": "string", "minLength": 1},
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "inference"],
      "properties": {
        "evidence": {"type": "string", "minLength": 1},
        "inference": {"type": "string", "minLength": 1}
      }
    },
    "attempted_approaches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approach", "outcome", "evidence"],
        "properties": {
          "approach": {"type": "string", "minLength": 1},
          "outcome": {
            "enum": ["failed", "rejected", "partial", "resolved", "workaround", "held"]
          },
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "resolution_state": {
      "enum": ["resolved", "workaround", "held", "unresolved", "superseded"]
    },
    "resolution_or_workaround": {"type": "string", "minLength": 1},
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_or_reference", "hash_or_test", "role", "evidence_kind"],
        "properties": {
          "path_or_reference": {"type": "string", "minLength": 1},
          "hash_or_test": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "evidence_kind": {
            "enum": ["current_file", "source_scan", "historical_hash", "external_url", "computation"]
          }
        }
      }
    },
    "residual_risk": {"type": "string", "minLength": 1},
    "recurrence_cues": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "transferable_lesson": {"type": "string", "minLength": 1},
    "future_check": {"type": "string", "minLength": 1},
    "related_decision_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "changed_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "supersession_state": {
      "enum": ["active", "corrects_prior", "superseded", "not_applicable"]
    },
    "validation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "external_human"],
      "properties": {
        "internal": {"type": "string", "minLength": 1},
        "external_human": {"type": "string", "minLength": 1}
      }
    },
    "continuation_or_revisit": {"type": "string", "minLength": 1}
  }
}
