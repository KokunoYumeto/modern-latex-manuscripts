{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schema/cjk/ko/noether/p29/u01/typed-concept-evidence-graph-1.0.0",
  "title": "Korean Noether Paper 29 U01 typed concept/evidence graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "graph_id",
    "graph_type",
    "formal_weighted_automaton",
    "weight_semantics",
    "nodes",
    "edges",
    "interpretation_limit"
  ],
  "properties": {
    "schema_id": {
      "const": "interlanguage.typed-concept-evidence-graph"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "graph_id": {
      "const": "noether.paper29.ko.u01.typed-evidence-dag"
    },
    "graph_type": {
      "const": "typed_directed_acyclic_evidence_graph"
    },
    "formal_weighted_automaton": {
      "const": false
    },
    "weight_semantics": {
      "const": "No edge weights are used; the graph records provenance and control routing, not truth probability or readiness."
    },
    "nodes": {
      "type": "array",
      "minItems": 69,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label",
              "language",
              "authority_kind",
              "source_provenance",
              "locator",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "SOURCE"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "authority_kind": {
                "enum": [
                  "sealed_source_authority",
                  "bounded_source_witness"
                ]
              },
              "source_provenance": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9A-F]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label",
              "concept_id",
              "source_form",
              "sense_window",
              "excluded_senses",
              "trap_class"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "CONCEPT"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "concept_id": {
                "type": "string",
                "minLength": 1
              },
              "source_form": {
                "type": "string",
                "minLength": 1
              },
              "sense_window": {
                "type": "string",
                "minLength": 1
              },
              "excluded_senses": {
                "type": "string",
                "minLength": 1
              },
              "trap_class": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label",
              "language",
              "script_profile",
              "value",
              "hanja_record",
              "status",
              "basin_membership"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "FORM"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "const": "ko-KR"
              },
              "script_profile": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "hanja_record": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "accepted_for_ko_KR",
                  "source_label_on_first_occurrence",
                  "accepted_with_sense_window",
                  "held_for_human_review",
                  "accepted_with_source_label",
                  "accepted_with_quotes"
                ]
              },
              "basin_membership": {
                "enum": [
                  "global_greco_latin_or_other_modern_loan",
                  "mixed_or_contested",
                  "modern_sino_xenic_coinage_or_calque",
                  "native_coinage",
                  "sino_xenic_inherited",
                  "unresolved"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label",
              "evidence_id",
              "channel",
              "authority_kind",
              "language",
              "source_provenance",
              "row_sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "EVIDENCE"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "enum": [
                  "support",
                  "adverse",
                  "absence",
                  "veto"
                ]
              },
              "authority_kind": {
                "enum": [
                  "external_source_evidence",
                  "adverse_evidence"
                ]
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "source_provenance": {
                "type": "string",
                "minLength": 1
              },
              "row_sha256": {
                "type": "string",
                "pattern": "^[0-9A-F]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label",
              "control_id",
              "rule",
              "scalar_readiness_semantics"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "CONTROL"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "control_id": {
                "type": "string",
                "minLength": 1
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "scalar_readiness_semantics": {
                "const": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label",
              "decision_id",
              "status",
              "basis_kinds",
              "human_validation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "DECISION"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "decision_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "accepted_for_ko_KR",
                  "source_label_on_first_occurrence",
                  "accepted_with_sense_window",
                  "held_for_human_review",
                  "accepted_with_source_label",
                  "accepted_with_quotes"
                ]
              },
              "basis_kinds": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "source_fact",
                    "computation",
                    "editorial_inference",
                    "model_preference",
                    "external_source_evidence",
                    "human_validation"
                  ]
                }
              },
              "human_validation": {
                "const": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "label",
              "language",
              "path",
              "sha256",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "TARGET"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "const": "ko-KR"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9A-F]{64}$"
              },
              "state": {
                "const": "source_checked_working_unit_not_externally_validated"
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type",
          "scope"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "CONTAINS",
              "FIXES_SOURCE_SENSE",
              "HAS_KOREAN_CANDIDATE",
              "SUPPORTS_LOCAL_USAGE",
              "CONSTRAINS_DECISION",
              "SELECTED_AS",
              "GOVERNS_TARGET",
              "PROHIBITS_KO_KP_CLAIM",
              "PROHIBITS_CROSS_LANGUAGE_PROMOTION",
              "PROHIBITS_MANDARIN_SUBSTITUTION"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interpretation_limit": {
      "type": "string",
      "minLength": 1
    }
  }
}
