{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schema/cjk/ko/noether/p29/u01/terminology-decisions-1.0.0",
  "title": "Korean Noether Paper 29 U01 terminology decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_id",
    "work_unit",
    "authority",
    "evidence_artifacts",
    "evidence_catalog",
    "decisions",
    "interpretation_limit"
  ],
  "properties": {
    "schema_id": {
      "const": "interlanguage.cjk.ko.terminology-decisions"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "const": "KO-NOE-P29-U01-TERMINOLOGY-DECISIONS-20260718"
    },
    "work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_id",
        "target_unit_id",
        "scope",
        "source_language",
        "target_language",
        "standard_scope",
        "continuation_cursor",
        "time_precision"
      ],
      "properties": {
        "source_unit_id": {
          "const": "NOE-P29-DE-P31-U01"
        },
        "target_unit_id": {
          "const": "NOE-P29-KO-U01"
        },
        "scope": {
          "const": "title, publication and author apparatus, and complete introduction through source line 24"
        },
        "source_language": {
          "const": "de"
        },
        "target_language": {
          "const": "ko-KR"
        },
        "standard_scope": {
          "const": "South-Korean mathematical register only; no North-Korean claim"
        },
        "continuation_cursor": {
          "const": "Paper 29 source line 25: subsection § 1. Das Endlichkeitskriterium"
        },
        "time_precision": {
          "const": "2026-07-18 (day precision)"
        }
      }
    },
    "authority": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "authority_kind",
          "sha256",
          "bytes"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "authority_kind": {
            "enum": [
              "sealed_source_authority",
              "bounded_source_witness",
              "target_artifact"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9A-F]{64}$"
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "authority_kind",
          "sha256",
          "bytes"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "authority_kind": {
            "const": "bounded_source_witness"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9A-F]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidence_catalog": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_kind",
          "authority_scope",
          "language",
          "source_provenance",
          "source_locator",
          "row_sha256",
          "containing_artifact_path",
          "containing_artifact_sha256",
          "validation_state"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
            "enum": [
              "external_source_evidence",
              "adverse_evidence"
            ]
          },
          "authority_scope": {
            "enum": [
              "local_language_usage_support",
              "editorial_risk_control"
            ]
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "source_provenance": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "row_sha256": {
            "type": "string",
            "pattern": "^[0-9A-F]{64}$"
          },
          "containing_artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "containing_artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9A-F]{64}$"
          },
          "validation_state": {
            "enum": [
              "source_observed_not_human_validation",
              "internal_adverse_record"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "term_id",
          "concept_id",
          "source_form",
          "target_form",
          "hanja_record",
          "source_locators",
          "target_locators",
          "language_tag",
          "script_profile",
          "register",
          "sense_window",
          "excluded_senses",
          "trap_class",
          "choice",
          "alternatives_considered",
          "motivation",
          "decision_basis_kinds",
          "evidence_ids",
          "adverse_evidence_ids",
          "confidence",
          "decision_status",
          "basin_membership",
          "dominant_standard_risk",
          "dominance_debt_note",
          "underrepresented_cohort_effect",
          "standard_decision",
          "uncertainty",
          "review_and_supersession"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^KO-P29-U01-TERMDEC-[0-9]{3}$"
          },
          "term_id": {
            "type": "string",
            "pattern": "^KO-P29-T[0-9]{3}$"
          },
          "concept_id": {
            "type": "string",
            "pattern": "^noether\\.p29\\.u01\\.[a-z0-9_]+$"
          },
          "source_form": {
            "type": "string",
            "minLength": 1
          },
          "target_form": {
            "type": "string",
            "minLength": 1
          },
          "hanja_record": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "language_tag": {
            "const": "ko-KR"
          },
          "script_profile": {
            "const": "Hangul running text; Hanja metadata only; German source label retained where declared"
          },
          "register": {
            "const": "historical invariant theory / graduate algebra"
          },
          "sense_window": {
            "type": "string",
            "minLength": 1
          },
          "excluded_senses": {
            "type": "string",
            "minLength": 1
          },
          "trap_class": {
            "type": "string",
            "minLength": 1
          },
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "alternatives_considered": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "form",
                "disposition",
                "basis_kind",
                "reason"
              ],
              "properties": {
                "form": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "rejected",
                    "held_not_promoted"
                  ]
                },
                "basis_kind": {
                  "enum": [
                    "editorial_inference",
                    "model_preference"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "motivation": {
            "type": "string",
            "minLength": 1
          },
          "decision_basis_kinds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "source_fact",
                "computation",
                "editorial_inference",
                "model_preference",
                "external_source_evidence",
                "human_validation"
              ]
            }
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "adverse_evidence_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "decision_status": {
            "enum": [
              "accepted_for_ko_KR",
              "source_label_on_first_occurrence",
              "accepted_with_sense_window",
              "held_for_human_review",
              "accepted_with_source_label",
              "accepted_with_quotes"
            ]
          },
          "basin_membership": {
            "enum": [
              "global_greco_latin_or_other_modern_loan",
              "mixed_or_contested",
              "modern_sino_xenic_coinage_or_calque",
              "native_coinage",
              "sino_xenic_inherited",
              "unresolved"
            ]
          },
          "dominant_standard_risk": {
            "enum": [
              "clear",
              "risk",
              "adverse"
            ]
          },
          "dominance_debt_note": {
            "type": "string",
            "minLength": 1
          },
          "underrepresented_cohort_effect": {
            "enum": [
              "unavailable",
              "potentially_distorted",
              "vetoed",
              "not_applicable"
            ]
          },
          "standard_decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ko_kr",
              "ko_kp",
              "running_text_policy"
            ],
            "properties": {
              "ko_kr": {
                "type": "string",
                "minLength": 1
              },
              "ko_kp": {
                "const": "unverified_do_not_claim"
              },
              "running_text_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "residual_risk",
              "revisit_condition",
              "external_human_validation"
            ],
            "properties": {
              "residual_risk": {
                "type": "string",
                "minLength": 1
              },
              "revisit_condition": {
                "type": "string",
                "minLength": 1
              },
              "external_human_validation": {
                "const": false
              }
            }
          },
          "review_and_supersession": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "review_state",
              "publication_state",
              "supersedes",
              "superseded_by"
            ],
            "properties": {
              "review_state": {
                "const": "internal_source_and_sense_check_only"
              },
              "publication_state": {
                "const": "working_not_publication_ready"
              },
              "supersedes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "superseded_by": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "interpretation_limit": {
      "type": "string",
      "minLength": 1
    }
  }
}
