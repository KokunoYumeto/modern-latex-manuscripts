{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/modern-latex-manuscripts/blob/main/interlanguage-sidecar/cjk-notation/v1/report.schema.json",
  "title": "CJK notation backend conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "unit_id", "authority", "target", "changed_loci", "formula_obligations", "note_obligations", "states", "adapters", "build_details", "extraction_details", "render_details", "exceptions", "evidence"],
  "properties": {
    "schema": {"const": "cjk-notation-report-v2"},
    "profile": {"enum": ["zh-Hans-CN", "zh-Hans-SG", "zh-Hant-generic", "zh-Hant-TW", "zh-Hant-HK", "zh-Hant-MO", "ja", "ko-KR", "ko-KP"]},
    "unit_id": {"type": "string", "minLength": 1},
    "authority": {"$ref": "#/$defs/locus_identity"},
    "target": {"$ref": "#/$defs/locus_identity"},
    "changed_loci": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "formula_obligations": {"type": "array", "items": {"$ref": "#/$defs/formula_obligation"}},
    "note_obligations": {"type": "array", "items": {"$ref": "#/$defs/note_obligation"}},
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_binding", "formula_projection", "note_apparatus", "locale_profile", "build", "extraction", "render"],
      "properties": {
        "source_binding": {"$ref": "#/$defs/state"},
        "formula_projection": {"$ref": "#/$defs/state"},
        "note_apparatus": {"$ref": "#/$defs/state"},
        "locale_profile": {"$ref": "#/$defs/state"},
        "build": {"$ref": "#/$defs/state"},
        "extraction": {"$ref": "#/$defs/state"},
        "render": {"$ref": "#/$defs/state"}
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_formula", "notes", "locale", "font", "build"],
      "properties": {
        "source_formula": {"$ref": "#/$defs/artifact_identity"},
        "notes": {"$ref": "#/$defs/artifact_identity"},
        "locale": {"$ref": "#/$defs/artifact_identity"},
        "font": {"$ref": "#/$defs/artifact_identity"},
        "build": {"$ref": "#/$defs/artifact_identity"}
      }
    },
    "build_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "font_profile", "passes", "pdf"],
      "properties": {
        "engine": {"$ref": "#/$defs/software_identity"},
        "font_profile": {"$ref": "#/$defs/artifact_identity"},
        "passes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "pdf_sha256", "auxiliary_sha256"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "pdf_sha256": {"$ref": "#/$defs/sha256"},
              "auxiliary_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "pdf": {"$ref": "#/$defs/artifact_identity"}
      }
    },
    "extraction_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractors", "font_inventory"],
      "properties": {
        "extractors": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["software", "output", "nul", "c0", "replacement"],
            "properties": {
              "software": {"$ref": "#/$defs/software_identity"},
              "output": {"$ref": "#/$defs/artifact_identity"},
              "nul": {"type": "integer", "minimum": 0},
              "c0": {"type": "integer", "minimum": 0},
              "replacement": {"type": "integer", "minimum": 0}
            }
          }
        },
        "font_inventory": {"$ref": "#/$defs/artifact_identity"}
      }
    },
    "render_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "page_count", "rendered_pages", "inspected_pages", "render_set", "changed_pages"],
      "properties": {
        "renderer": {"$ref": "#/$defs/software_identity"},
        "page_count": {"type": "integer", "minimum": 1},
        "rendered_pages": {"type": "integer", "minimum": 0},
        "inspected_pages": {"type": "integer", "minimum": 0},
        "render_set": {"$ref": "#/$defs/artifact_identity"},
        "changed_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}
      }
    },
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_identity"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "bytes", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "locus_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "locus", "bytes", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "locus": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "software_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "evidence_ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"},
    "evidence_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact", "locus", "bytes", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/evidence_ref"},
        "artifact": {"type": "string", "minLength": 1},
        "locus": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locus", "kind", "before_sha256", "after_sha256", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "locus": {"type": "string", "minLength": 1},
        "kind": {"enum": ["authority_delta", "target_correction", "locale_transformation", "layout_only", "metadata_only"]},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true}
      }
    },
    "formula_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_locus", "target_loci", "disposition", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_locus": {"type": "string", "minLength": 1},
        "target_loci": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "disposition": {"enum": ["preserved", "declared_repeat", "source_correction", "omitted_with_reason"]},
        "exception_id": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true}
      },
      "allOf": [{"if": {"properties": {"disposition": {"not": {"const": "preserved"}}}}, "then": {"required": ["exception_id"]}}]
    },
    "note_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_locus", "target_locus", "placement", "retained_count", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_locus": {"type": "string", "minLength": 1},
        "target_locus": {"type": "string", "minLength": 1},
        "placement": {"enum": ["inline", "separated_mark_text", "integrated_prose", "apparatus"]},
        "retained_count": {"const": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_run", "not_applicable", "unsupported"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["pass", "fail"]}}}, "then": {"properties": {"evidence": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"enum": ["fail", "not_run", "not_applicable", "unsupported"]}}}, "then": {"required": ["reason"]}}
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locus", "reason", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["declared_repeat", "localized_prose", "source_correction", "asset_substitution", "layout_only"]},
        "locus": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}, "uniqueItems": true}
      }
    }
  }
}
