{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/modern-latex-manuscripts/blob/main/interlanguage-sidecar/cjk-notation/v1/doi.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "version",
    "publication_date",
    "publication_role",
    "repository",
    "containing_record",
    "resource_type",
    "access_right",
    "record_license",
    "description",
    "creators",
    "keywords",
    "relations",
    "exclusive_component_doi_claim"
  ],
  "properties": {
    "schema": {"const": "cjk-notation-component-publication-identity-v1"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publication_date": {"type": "string", "format": "date"},
    "publication_role": {"const": "component_of_existing_interlanguage_sidecar"},
    "repository": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
    "containing_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "zenodo_record_id", "zenodo_concept_record_id", "version_doi", "concept_doi"],
      "properties": {
        "title": {"const": "Interlanguage and Mathematical Translation Methodology Sidecar"},
        "zenodo_record_id": {"type": "integer", "minimum": 1},
        "zenodo_concept_record_id": {"type": "integer", "minimum": 1},
        "version_doi": {"type": "string", "pattern": "^10\\.5281/zenodo\\.[0-9]+$"},
        "concept_doi": {"type": "string", "pattern": "^10\\.5281/zenodo\\.[0-9]+$"}
      }
    },
    "resource_type": {"const": "dataset"},
    "access_right": {"const": "open"},
    "record_license": {"const": "cc-zero"},
    "description": {"type": "string", "minLength": 1},
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "relation", "resource_type"],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "relation": {"const": "IsSupplementedBy"},
          "resource_type": {"const": "software"}
        }
      }
    },
    "exclusive_component_doi_claim": {"const": false}
  }
}
