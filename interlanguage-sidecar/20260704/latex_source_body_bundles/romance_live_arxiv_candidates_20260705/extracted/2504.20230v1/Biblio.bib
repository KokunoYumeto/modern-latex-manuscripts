@article{HarSza,
  title = {On {{Tate}}--{{Shafarevich}} Groups of One-Dimensional Families of Commutative Group Schemes over Number Fields},
  author = {Harari, D. and Szamuely,T.},
  year = {2022},
  month = oct,
  journal = {Mathematische Zeitschrift},
  volume = {302},
  number = {2},
  pages = {935--948},
  issn = {0025-5874, 1432-1823},
  doi = {10.1007/s00209-022-03080-x},
  urldate = {2024-05-07},
  abstract = {Given a smooth geometrically connected curve C over a field k and a smooth commutative group scheme G of finite type over the function field K of C we study the Tate--Shafarevich groups X1C (G) given by elements of H1(K, G) locally trivial at completions of K associated with closed points of C. When G comes from a k-group scheme and k is a number field (or k is a finitely generated field and C has a k-point) we prove finiteness of X1C (G) generalizing a result of Sa{\textasciidieresis}{\i}di and Tamagawa for abelian varieties. We also give examples of nontrivial X1C (G) in the case when G is a torus and prove other related statements.},
  langid = {english},
  file = {/Users/melvyn.elkamel-meyrigne/Zotero/storage/S5JJ5C8F/Harari et Szamuely - 2022 - On Tate–Shafarevich groups of one-dimensional fami.pdf}
}

@article{Izquierdo,
  title = {{Dualit{\'e} et principe local-global pour les anneaux locaux hens{\'e}liens de dimension 2}},
  author = {Izquierdo, D.},
  abstract = {Let k be an algebraically closed eld, a nite eld or a p-adic eld. Let K0 = k((x, y)) be the eld of Laurent series in two variables over k and let K be a nite extension of K0. We dene Tate-Shafarevich groups of a commutative group scheme over K via cohomology classes locally trivial at each completion of K coming from a codimension 1 point of Spec OK, where OK is the integral closure of k[[x, y]] in K. We establish duality theorems between Tate-Shafarevich groups for nite groups schemes and for tori. We apply these results to the study of the obstruction to the local-global principle for K-torsors under a connected linear algebraic group, answering in that way a question of Colliot-Th{\'e}l{\`e}ne, Parimala and Suresh, and to the weak approximation for tori over K.},
  langid = {french},
  file = {/Users/melvyn.elkamel-meyrigne/Zotero/storage/X2P4W54X/Izquierdo - Dualité et principe local-global pour les anneaux .pdf}
}
