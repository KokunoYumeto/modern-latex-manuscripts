{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slisv-isv-mi-preregistration-v002.schema.json",
  "title": "Fail-closed Interslavic marginal-intelligibility Stage-0 preregistration v002",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "protocol_id",
    "version",
    "recorded_at",
    "timezone",
    "status",
    "purpose",
    "authority_cutoff",
    "input_repin_audit",
    "official_authority",
    "evidence_model",
    "family_tree",
    "current_state",
    "stage0_design",
    "launch_gates",
    "claim_boundary",
    "proof_boundary",
    "continuation_cursor"
  ],
  "properties": {
    "$schema": {
      "const": "./ISV_MI_PREREGISTRATION_V002.schema.json"
    },
    "schema_id": {
      "const": "slisv-isv-mi-preregistration-v002"
    },
    "protocol_id": {
      "const": "SLISV-ISV-MI-PREREG-20260812-002"
    },
    "version": {
      "const": "0.0.2-bounded-stage0-proposal"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "\\+02:00$"
    },
    "timezone": {
      "const": "Europe/Berlin"
    },
    "status": {
      "const": "fail_closed_not_launch_ready_no_human_validation"
    },
    "purpose": {
      "type": "string",
      "minLength": 100
    },
    "authority_cutoff": {
      "type": "object",
      "required": [
        "substantive_decision_prefix_through",
        "post_cutoff_corrections_consumed",
        "decision_068_serializations",
        "rule"
      ],
      "properties": {
        "substantive_decision_prefix_through": {
          "const": "SLISV-20260812-070"
        },
        "decision_log_prefix_pin_id": {
          "const": "PIN-DECISION-LOG-PREFIX-070"
        },
        "post_cutoff_corrections_consumed": {
          "const": [
            "SLISV-20260812-072",
            "SLISV-20260812-073"
          ]
        },
        "post_cutoff_substantive_decisions_consumed": {
          "const": []
        },
        "decision_068_serializations": {
          "type": "object"
        },
        "rule": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "input_repin_audit": {
      "type": "object",
      "required": [
        "path",
        "pin_count",
        "all_pins_required",
        "upstream_mutation_allowed"
      ],
      "properties": {
        "path": {
          "const": "INPUT_REPIN_AUDIT_V002.json"
        },
        "pin_count": {
          "type": "integer",
          "minimum": 1
        },
        "all_pins_required": {
          "const": true
        },
        "upstream_mutation_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "official_authority": {
      "type": "object"
    },
    "evidence_model": {
      "type": "object",
      "required": [
        "object_type",
        "dag_pin_id",
        "workspace_relative_path",
        "bytes",
        "sha256",
        "acyclic_required",
        "acyclic_replayed",
        "channels",
        "may_define_human_intelligibility",
        "may_auto_decide"
      ],
      "properties": {
        "object_type": {
          "const": "typed_evidence_DAG"
        },
        "dag_pin_id": {
          "const": "PIN-DAG-001"
        },
        "workspace_relative_path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "acyclic_required": {
          "const": true
        },
        "acyclic_replayed": {
          "const": true
        },
        "channels": {
          "const": [
            "support",
            "candidate",
            "competitor",
            "adverse",
            "absence",
            "veto"
          ]
        },
        "absence_is_not_adverse": {
          "const": true
        },
        "candidate_is_not_support": {
          "const": true
        },
        "positive_mass_offsets_adverse": {
          "const": false
        },
        "may_define_human_intelligibility": {
          "const": false
        },
        "may_auto_decide": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "family_tree": {
      "type": "object",
      "required": [
        "tree_pin_id",
        "macrobranches",
        "macrobranches_symmetric",
        "missing_leaf_rule",
        "cyrillic_interslavic_is_independent_leaf"
      ],
      "properties": {
        "tree_pin_id": {
          "const": "PIN-TREE-001"
        },
        "macrobranches": {
          "const": [
            "east_slavic",
            "west_slavic",
            "south_slavic"
          ]
        },
        "macrobranches_symmetric": {
          "const": true
        },
        "numeric_edge_lengths": {
          "type": "null"
        },
        "empirical_weights": {
          "type": "null"
        },
        "population_weights": {
          "type": "null"
        },
        "missing_leaf_rule": {
          "const": "unknown_not_zero_not_imputed"
        },
        "cyrillic_interslavic_is_independent_leaf": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "current_state": {
      "type": "object",
      "required": [
        "german_authority",
        "latin_candidate_v003",
        "successor_input_v004",
        "semantic_boundary_review",
        "coordinate_rebase_v001",
        "item_and_morphology",
        "community_review",
        "human_evidence"
      ]
    },
    "stage0_design": {
      "type": "object",
      "required": [
        "design_state",
        "study_unit",
        "leaf_sampling",
        "arms",
        "assignment",
        "passages",
        "outcome_vector",
        "reporting",
        "missing_data",
        "analysis_and_decision"
      ]
    },
    "launch_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "criterion",
          "state"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^PREREG2-G[0-9]{3}$"
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "pass",
              "blocked",
              "not_a_launch_gate"
            ]
          }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "permitted",
        "prohibited",
        "reader_or_translation_bytes_mutated",
        "participant_launch_performed",
        "outreach_performed",
        "publication_handoff_ready"
      ],
      "properties": {
        "permitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reader_or_translation_bytes_mutated": {
          "const": false
        },
        "participant_launch_performed": {
          "const": false
        },
        "outreach_performed": {
          "const": false
        },
        "publication_handoff_ready": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "proof_boundary": {
      "type": "object",
      "required": [
        "proves",
        "does_not_prove"
      ],
      "properties": {
        "proves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "does_not_prove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "continuation_cursor": {
      "type": "string",
      "minLength": 100
    }
  }
}
