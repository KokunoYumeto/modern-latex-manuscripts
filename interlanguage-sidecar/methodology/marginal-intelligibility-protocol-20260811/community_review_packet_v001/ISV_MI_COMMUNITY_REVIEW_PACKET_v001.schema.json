        "hash_convention"
      ],
      "properties": {
        "line_1based": {
          "type": "integer",
          "minimum": 1
        },
        "window_start_column_scalar_1based": {
          "type": "integer",
          "minimum": 1
        },
        "window_end_column_scalar_exclusive_1based": {
          "type": "integer",
          "minimum": 2
        },
        "candidate_start_in_window_scalar_0based": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_end_in_window_scalar_exclusive_0based": {
          "type": "integer",
          "minimum": 1
        },
        "line_scalar_length": {
          "type": "integer",
          "minimum": 1
        },
        "line_text_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "window_text": {
          "type": "string",
          "minLength": 1
        },
        "window_text_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "hash_convention": {
          "const": "UTF-8 scalar text without line terminator"
        }
      }
    },
    "norm_semantic_focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mathematical_or_prose_sense",
        "part_of_speech",
        "inflection_or_features",
        "classification"
      ],
      "properties": {
        "mathematical_or_prose_sense": {
          "type": "string"
        },
        "part_of_speech": {
          "type": "string"
        },
        "inflection_or_features": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "evidence_role",
        "branch_scope",
        "path",
        "file_sha256",
        "line_1based",
        "column_start_scalar_1based",
        "column_end_scalar_exclusive_1based",
        "surface",
        "surface_sha256",
        "logical_line_sha256",
        "context_excerpt",
        "context_excerpt_sha256",
        "alignment_note"
      ],
      "properties": {
        "role": {
          "enum": [
            "de",
            "ru",
            "uk",
            "isv"
          ]
        },
        "evidence_role": {
          "type": "string"
        },
        "branch_scope": {
          "enum": [
            "meaning_authority",
            "east_slavic_only",
            "constructed_interslavic_baseline"
          ]
        },
        "path": {
          "type": "string"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "line_1based": {
          "type": "integer"
        },
        "column_start_scalar_1based": {
          "type": "integer"
        },
        "column_end_scalar_exclusive_1based": {
          "type": "integer"
        },
        "surface": {
          "type": "string"
        },
        "surface_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "logical_line_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "context_excerpt": {
          "type": "string"
        },
        "context_excerpt_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "alignment_note": {
          "type": "string"
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "state",
        "basis_or_reason"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "basis_or_reason": {
          "type": "string"
        }
      }
    },
    "normalization_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_kind",
        "choice_group",
        "source_ledger_id",
        "upstream_id",
        "effect_locus",
        "context_window",
        "comparison_surfaces",
        "comparison_alignment_state",
        "semantic_focus",
        "current_surface",
        "candidate_latin_surface",
        "candidate_cyrillic_surface",
        "alternatives",
        "adverse_evidence",
        "evidence_facts",
        "primary_question",
        "required_reviewer_profiles",
        "response_slots",
        "review_state",
        "source_record_semantic_sha256",
        "application_state"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^CRP-NORM-(0[1-9]|1[0-4])$"
        },
        "request_kind": {
          "const": "normalization_context_choice"
        },
        "choice_group": {
          "enum": [
            "simultaneity",
            "korak_step",
            "noether_neter",
            "weierstrass_recast"
          ]
        },
        "source_ledger_id": {
          "type": "string"
        },
        "upstream_id": {
          "type": "string"
        },
        "effect_locus": {
          "$ref": "#/$defs/effect"
        },
        "context_window": {
          "$ref": "#/$defs/context"
        },
        "comparison_surfaces": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "comparison_alignment_state": {
          "const": "exact_locators_and_hashes_bound_same_information_or_policy_alignment_pending_qualified_review"
        },
        "semantic_focus": {
          "$ref": "#/$defs/norm_semantic_focus"
        },
        "current_surface": {
          "type": "string"
        },
        "candidate_latin_surface": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_cyrillic_surface": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "adverse_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "primary_question": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "question_id",
            "question",
            "response"
          ],
          "properties": {
            "question_id": {
              "type": "string"
            },
            "reviewer_profile_id": {
              "type": "string"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "response": {
              "type": "null"
            }
          }
        },
        "required_reviewer_profiles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "RP-WEST-AUTHOR",
              "RP-SOUTH-AUTHOR",
              "RP-INDEPENDENT-GRAMMAR",
              "RP-COMMUNITY-GOVERNANCE"
            ]
          }
        },
        "response_slots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "west_branch_review",
            "south_branch_review",
            "independent_grammar_review",
            "community_governance_comment"
          ],
          "properties": {
            "west_branch_review": {
              "type": "null"
            },
            "south_branch_review": {
              "type": "null"
            },
            "independent_grammar_review": {
              "type": "null"
            },
            "community_governance_comment": {
              "type": "null"
            }
          }
        },
        "review_state": {
          "const": "held_no_attributable_review_return"
        },
        "source_record_semantic_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "application_state": {
          "const": "no_application_no_release_no_claim"
        }
      }
    }
  }
}
